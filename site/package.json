{
  "name": "falco-archive",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4322",
    "atlas": "python3 ../tools/atlas.py",
    "build": "npm run check:pin && npm run atlas && npm run publish:index && astro build && npm run check && npm run sitemap && npm run check:living && npm run check:templates && npm run check:kit && npm run check:worklist && npm run check:covers && npm run check:corrections && npm run check:evidence && npm run check:sources && npm run check:pages && npm run check:inline",
    "preview": "astro preview --port 4322",
    "check": "python3 ../tools/check_release.py",
    "build:nocheck": "astro build",
    "sitemap": "python3 node_modules/@daviddef/archive-kit/kit/tools/sitemap.py",
    "publish:index": "node -e \"require('fs').copyFileSync('src/data/searchindex.json','public/searchindex.json')\"",
    "check:kit": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkarchive.py --dist dist",
    "check:living": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkliving.py --dist dist --data src/data --policy named-bare",
    "check:worklist": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkworklist.py --root .",
    "check:covers": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkcovers.py --root .",
    "check:corrections": "python3 ../tools/check_corrections.py",
    "check:evidence": "python3 ../tools/check_person_evidence.py",
    "check:templates": "python3 node_modules/@daviddef/archive-kit/kit/tools/checktemplates.py --root .",
    "check:sources": "python3 node_modules/@daviddef/archive-kit/kit/tools/checksources.py --root . --max-unreachable 2",
    "check:pages": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkpages.py --root . --estate ../.. --max-bespoke 4",
    "check:pin": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkpin.py --root .",
    "check:inline": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkinline.py --root . --max-inline 16"
  },
  "dependencies": {
    "@daviddef/archive-kit": "github:daviddef/TheArchiveKit#a2be0c333eb517d0a30208ca8c6b79ec53901b4f",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3"
  }
}
