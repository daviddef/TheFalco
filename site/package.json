{
  "name": "falco-archive",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4322",
    "atlas": "python3 ../tools/atlas.py",
    "build": "npm run check:pin && npm run atlas && npm run publish:index && astro build && npm run autolink && npm run check && npm run sitemap && npm run check:living && npm run check:living2 && npm run check:living-prose && npm run check:living-feed && npm run check:links && npm run check:kin && npm run check:templates && npm run check:kit && npm run check:worklist && npm run check:covers && npm run check:households && npm run check:fscite && npm run check:corrections && npm run check:prose && npm run check:evidence && npm run check:sources && npm run check:pages && npm run check:inline && npm run check:rows && npm run check:nav && npm run check:book",
    "preview": "astro preview --port 4322",
    "check": "python3 ../tools/check_release.py",
    "build:nocheck": "astro build",
    "autolink": "python3 ../tools/build_names_index.py && python3 node_modules/@daviddef/archive-kit/kit/tools/autolink.py --dist dist --index ../private/names-index.json --living ../private/living-links.json --allow-prefix /people/ --allow-prefix /who/",
    "check:links": "python3 node_modules/@daviddef/archive-kit/kit/tools/checklinks.py --dist dist --index ../private/names-index.json --living ../private/living-links.json --floor .linkfloor.json --allow-prefix /people/ --allow-prefix /who/",
    "sitemap": "python3 node_modules/@daviddef/archive-kit/kit/tools/sitemap.py",
    "publish:index": "node -e \"require('fs').copyFileSync('src/data/searchindex.json','public/searchindex.json')\"",
    "check:kit": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkarchive.py --dist dist",
    "check:living": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkliving.py --dist dist --data src/data --policy named-bare",
    "check:living2": "python3 ../tools/check_living_v2.py --dist dist",
    "selftest:living2": "python3 ../tools/check_living_v2.py --dist dist --selftest",
    "check:worklist": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkworklist.py --root .",
    "check:covers": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkcovers.py --root .",
    "check:corrections": "python3 ../tools/check_corrections.py",
    "check:evidence": "python3 ../tools/check_person_evidence.py",
    "check:templates": "python3 node_modules/@daviddef/archive-kit/kit/tools/checktemplates.py --root . --require",
    "check:sources": "python3 node_modules/@daviddef/archive-kit/kit/tools/checksources.py --root . --max-unreachable 2",
    "check:pages": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkpages.py --root . --estate ../.. --max-bespoke 4",
    "check:pin": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkpin.py --root .",
    "check:book": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkbook.py --dist dist --book src/data/book.json",
    "check:nav": "python3 node_modules/@daviddef/archive-kit/kit/tools/checknav.py --dist dist --strict",
    "check:inline": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkinline.py --root . --max-inline 16",
    "check:rows": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkrows.py --root . --require",
    "check:prose": "python3 ../tools/check_prose.py",
    "check:living-prose": "python3 ../tools/check_living_prose.py",
    "check:living-feed": "python3 ../tools/living_feed.py check --dist dist",
    "check:living-prose-strict": "python3 ../tools/check_living_prose.py --require-tree",
    "check:households": "python3 ../tools/check_households.py",
    "check:fscite": "python3 ../tools/check_fscite.py",
    "check:kin": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkkin.py --require --data src/data/people.json --born b --died d --max 1"
  },
  "dependencies": {
    "@daviddef/archive-kit": "github:daviddef/TheArchiveKit#ef1a93c668021ef00954bab409d2daa33e35bbf9",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3"
  }
}
