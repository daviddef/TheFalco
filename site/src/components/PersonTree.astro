---
/* A person drawn with the people they belong to: parents above, the couple in
 * the middle, children below, siblings beside.
 *
 * Every edge carries where it came from, because the two sources are not of
 * equal weight and the archive must not pretend otherwise:
 *
 *   line      the archive's own identification, argued act by act on /direct-line
 *   register  a clerk wrote this relationship down and the act has been read
 *   tree      the family tree says so, and nothing has verified it
 *
 * An edge keeps every source that carries it, so a reader can see when two
 * independent sources agree — and when one of them says something this archive
 * has already retracted.
 *
 * Living people appear as a name and a place in the family. No dates. That is
 * the rule set on 10 September 2026 and it is enforced in the data, not here.
 */
import { u } from "../lib/url.js";
import { bySlug } from "../lib/people.js";

const { person: p } = Astro.props;

const get = (b) => (p[b] || []).map((e) => ({ ...e, rec: bySlug.get(e.slug) }));
const parents  = get("parents");
const spouses  = get("spouses");
const children = get("children");
const siblings = get("siblings");

const dates = (r) => {
  if (!r || r.living) return "";
  if (r.b && r.d) return `${r.b} – ${r.d}`;
  if (r.b) return `b. ${r.b}`;
  if (r.d) return `d. ${r.d}`;
  const e = (r.events || []).find((x) => x.date && x.date !== "—");
  return e ? e.date : "";
};

/* The tree carries three separate people called Simone Zampiello, all entered
   as brothers of one man. Almost certainly one person duplicated — but this
   archive does not merge records on a name, so they are shown as they are and
   the duplication is named. */
const clash = (rows) => {
  const seen = {};
  for (const r of rows) seen[r.name] = (seen[r.name] || 0) + 1;
  return Object.entries(seen).filter(([, n]) => n > 1).map(([n]) => n);
};
const clashChildren = clash(children);
const clashOther = [...new Set([...clash(siblings), ...clash(parents), ...clash(spouses)])];

const label = (e) => (e.vias || [e.via]).join(" + ");
const has = parents.length || spouses.length || children.length || siblings.length;
const superseded = [...parents, ...spouses, ...children, ...siblings].filter((e) => e.superseded);
---
{has ? (
<figure class="ptree">
  {parents.length ? (
    <div class="tier">
      <div class="lab">{parents.length === 1 ? "Parent" : "Parents"}</div>
      <div class="row">
        {parents.map((e) => (
          <a class={"node via-" + e.via + (e.superseded ? " gone" : "")}
             href={u("/people/" + e.slug)} title={e.superseded || ("Recorded by: " + label(e))}>
            <span class="nm">{e.name}</span>
            {dates(e.rec) ? <span class="dt">{dates(e.rec)}</span> : null}
            <span class="via">{e.superseded ? "superseded — " + label(e) : label(e)}</span>
          </a>
        ))}
      </div>
      <div class="drop" aria-hidden="true"></div>
    </div>
  ) : null}

  <div class="tier self">
    <div class="row">
      <div class="node me">
        <span class="nm">{p.name}</span>
        {dates(p) ? <span class="dt">{dates(p)}</span> : null}
        {p.gen ? <span class="via gen">generation {p.gen}</span> : null}
        {p.living ? <span class="via living">living — name only</span> : null}
      </div>
      {spouses.map((e) => (
        <a class={"node spouse via-" + e.via} href={u("/people/" + e.slug)} title={"Recorded by: " + e.via}>
          <span class="mar">married</span>
          <span class="nm">{e.name}</span>
          {dates(e.rec) ? <span class="dt">{dates(e.rec)}</span> : null}
          <span class="via">{label(e)}</span>
        </a>
      ))}
    </div>
  </div>

  {children.length ? (
    <div class="tier">
      <div class="drop up" aria-hidden="true"></div>
      <div class="lab">{children.length === 1 ? "Child" : `${children.length} children`}</div>
      <div class="row">
        {children.map((e) => (
          <a class={"node via-" + e.via + (e.superseded ? " gone" : "")}
             href={u("/people/" + e.slug)} title={e.superseded || ("Recorded by: " + label(e))}>
            <span class="nm">{e.name}</span>
            {dates(e.rec) ? <span class="dt">{dates(e.rec)}</span> : null}
            <span class="via">{e.superseded ? "superseded — " + label(e) : label(e)}</span>
          </a>
        ))}
      </div>
    </div>
  ) : null}

  {siblings.length ? (
    <div class="tier sibs">
      <div class="lab">{siblings.length === 1 ? "Sibling" : `${siblings.length} siblings`}</div>
      <div class="row">
        {siblings.map((e) => (
          <a class={"node small via-" + e.via} href={u("/people/" + e.slug)} title={"Recorded by: " + e.via}>
            <span class="nm">{e.name}</span>
            {dates(e.rec) ? <span class="dt">{dates(e.rec)}</span> : null}
          </a>
        ))}
      </div>
    </div>
  ) : null}

  <figcaption>
    <span class="key"><i class="sw line"></i> the archive's own line, argued on <a href={u("/direct-line")}>Direct line</a></span>
    <span class="key"><i class="sw register"></i> from a record this archive has read</span>
    <span class="key"><i class="sw tree"></i> from the family tree, unverified</span>
    {superseded.length ? (
      <p class="warn"><strong>One claim here is drawn struck through, and left in place on purpose.</strong>
      {" " + superseded[0].superseded} <strong>The archive corrects in the open rather than deleting</strong>,
      so the discarded parentage stays visible beside the one that replaced it.</p>
    ) : null}
    {clashChildren.length ? (
      <p class="warn"><strong>Two children here carry one name</strong> — {clashChildren.join(", ")}.
      In this parish that is usually not an error: <strong>a child who died was very often replaced by
      a later child given the same name</strong>. Luigi Cioffi and Mariantonia Venafra buried a
      Gaetana in 1839 and another Gaetana, aged four, in 1843. <strong>It is also exactly how a
      records-matcher invents one person out of two</strong>, which is why they are kept apart here
      and the reader is told.</p>
    ) : null}
    {clashOther.length ? (
      <p class="warn"><strong>More than one person in this row carries the same name</strong> —
      {" " + clashOther.join(", ")}. That is what the source says. <strong>This archive does not merge
      records on a name</strong>, so they are drawn separately even where one duplicated entry is the
      likelier explanation.</p>
    ) : null}
  </figcaption>
</figure>
) : null}

<style is:global>
  .ptree{margin:0 0 1.4rem;padding:1rem 1rem .8rem;border:1px solid var(--rule);border-radius:.4rem;
         background:var(--ground,transparent)}
  .ptree .tier{position:relative}
  .ptree .lab{font-family:var(--sans);font-size:10px;font-weight:600;letter-spacing:.13em;
              text-transform:uppercase;color:var(--ink-2);margin:.2rem 0 .45rem}
  .ptree .row{display:flex;flex-wrap:wrap;gap:.5rem;align-items:stretch}
  .ptree .node{display:flex;flex-direction:column;gap:.1rem;min-width:9.5rem;
               padding:.45rem .6rem;border:1px solid var(--rule);border-radius:.3rem;
               text-decoration:none;color:inherit;background:var(--paper,#fff)}
  .ptree a.node:hover{border-color:var(--accent)}
  .ptree .node.me{border-width:2px;border-color:var(--ink,currentColor)}
  .ptree .node.small{min-width:8rem;padding:.35rem .5rem}
  .ptree .nm{font-weight:600;line-height:1.2}
  .ptree .dt{font-family:var(--mono,monospace);font-size:11px;color:var(--ink-2)}
  .ptree .mar{font-family:var(--sans);font-size:9px;letter-spacing:.13em;text-transform:uppercase;
              color:var(--ink-2)}
  .ptree .via{font-family:var(--sans);font-size:9px;letter-spacing:.1em;text-transform:uppercase;
              color:var(--ink-2);margin-top:.15rem}
  /* the provenance of the edge, said in colour AND in words — colour alone
     would be no use to a reader who cannot see it */
  .ptree .via-register .via{color:var(--accent)}
  .ptree .node.via-register{border-left:3px solid var(--accent)}
  .ptree .node.via-tree{border-left:3px dotted var(--ink-2)}
  .ptree .node.via-line{border-left:3px solid var(--ink,currentColor)}
  .ptree .node.gone .nm{text-decoration:line-through;text-decoration-thickness:1px;opacity:.75}
  .ptree .node.gone{border-style:dashed;opacity:.85}
  .ptree .node.gone .via{font-style:italic}
  .ptree .via.gen{color:var(--accent);font-weight:600}
  .ptree .via.living{font-style:italic}
  .ptree .drop{height:.9rem;margin-left:1.4rem;border-left:1px solid var(--rule)}
  .ptree .sibs{margin-top:.9rem;padding-top:.7rem;border-top:1px dashed var(--rule)}
  .ptree figcaption{margin-top:.9rem;padding-top:.6rem;border-top:1px solid var(--rule);
                    font-family:var(--sans);font-size:11px;color:var(--ink-2)}
  .ptree .key{display:inline-flex;align-items:center;gap:.35rem;margin-right:1rem}
  .ptree .sw{width:.85rem;height:0;border-top:3px solid var(--accent);display:inline-block}
  .ptree .sw.tree{border-top-style:dotted;border-top-color:var(--ink-2)}
  .ptree .sw.line{border-top-color:var(--ink,currentColor);border-top-width:4px}
  .ptree .warn{margin:.5rem 0 0;line-height:1.5}
</style>
