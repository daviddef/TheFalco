---
/* A person drawn with the people they belong to. The chart itself is the kit's
 * — the same one Mazza and Blazevic draw. What stays here is what this archive
 * knows and the other two do not:
 *
 * Every edge carries where it came from, because the two sources are not of
 * equal weight and the archive must not pretend otherwise:
 *
 *   line      the archive's own identification, argued act by act on /direct-line
 *   register  a clerk wrote this relationship down and the act has been read
 *   tree      the family tree says so, and nothing has verified it
 *
 * An edge keeps every source that carries it, so a reader can see when two
 * independent sources agree — and when one of them says something this archive
 * has already retracted.
 *
 * Living people appear as a name and a place in the family. No dates. That is
 * the rule set on 10 September 2026 and it is enforced in the data, not here.
 */
import { u } from "../lib/url.js";
import { bySlug } from "../lib/people.js";
import PersonTree from "@daviddef/archive-kit/components/PersonTree.astro";
import "@daviddef/archive-kit/styles/persontree.css";

const { person: p } = Astro.props;

const get = (b) => (p[b] || []).map((e) => ({ ...e, rec: bySlug.get(e.slug) }));
const parents  = get("parents");
const spouses  = get("spouses");
const children = get("children");
const siblings = get("siblings");

const dates = (r) => {
  if (!r || r.living) return "";
  if (r.b && r.d) return `${r.b} – ${r.d}`;
  if (r.b) return `b. ${r.b}`;
  if (r.d) return `d. ${r.d}`;
  const e = (r.events || []).find((x) => x.date && x.date !== "—");
  return e ? e.date : "";
};

/* The tree carries three separate people called Simone Zampiello, all entered
   as brothers of one man. Almost certainly one person duplicated — but this
   archive does not merge records on a name, so they are shown as they are and
   the duplication is named. */
const clash = (rows) => {
  const seen = {};
  for (const r of rows) seen[r.name] = (seen[r.name] || 0) + 1;
  return Object.entries(seen).filter(([, n]) => n > 1).map(([n]) => n);
};
const clashChildren = clash(children);
const clashOther = [...new Set([...clash(siblings), ...clash(parents), ...clash(spouses)])];

const label = (e) => (e.vias || [e.via]).join(" + ");

/* Parents and children carry the full provenance and can be struck through;
   spouses and siblings are labelled by the single source that carries them. */
const lineage = (e) => ({
  name: e.name,
  href: u("/people/" + e.slug),
  dates: dates(e.rec),
  cls: "via-" + e.via + (e.superseded ? " gone" : ""),
  mark: e.superseded ? "superseded — " + label(e) : label(e),
  title: e.superseded || ("Recorded by: " + label(e)),
});
const beside = (e, mark) => ({
  name: e.name,
  href: u("/people/" + e.slug),
  dates: dates(e.rec),
  cls: "via-" + e.via,
  mark: mark ? label(e) : undefined,
  title: "Recorded by: " + e.via,
});

const superseded = [...parents, ...spouses, ...children, ...siblings].filter((e) => e.superseded);
---
<PersonTree
  self={{ name: p.name, dates: dates(p), gen: p.gen ? `generation ${p.gen}` : "", note: p.living ? "living — name only" : "", noteCls: "living" }}
  parents={parents.map(lineage)}
  spouses={spouses.map((e) => beside(e, true))}
  children={children.map(lineage)}
  siblings={siblings.map((e) => beside(e, false))}
>
  <Fragment slot="keys">
    <span class="key"><i class="sw line"></i> the archive's own line, argued on <a href={u("/direct-line/")}>Direct line</a></span>
    <span class="key"><i class="sw register"></i> from a record this archive has read</span>
    <span class="key"><i class="sw tree"></i> from the family tree, unverified</span>
  </Fragment>
  <Fragment slot="notes">
    {superseded.length ? (
      <p class="warn"><strong>One claim here is drawn struck through, and left in place on purpose.</strong>
      {" " + superseded[0].superseded} <strong>The archive corrects in the open rather than deleting</strong>,
      so the discarded parentage stays visible beside the one that replaced it.</p>
    ) : null}
    {clashChildren.length ? (
      <p class="warn"><strong>Two children here carry one name</strong> — {clashChildren.join(", ")}.
      In this parish that is usually not an error: <strong>a child who died was very often replaced by
      a later child given the same name</strong>. Luigi Cioffi and Mariantonia Venafra buried a
      Gaetana in 1839 and another Gaetana, aged four, in 1843. <strong>It is also exactly how a
      records-matcher invents one person out of two</strong>, which is why they are kept apart here
      and the reader is told.</p>
    ) : null}
    {clashOther.length ? (
      <p class="warn"><strong>More than one person in this row carries the same name</strong> —
      {" " + clashOther.join(", ")}. That is what the source says. <strong>This archive does not merge
      records on a name</strong>, so they are drawn separately even where one duplicated entry is the
      likelier explanation.</p>
    ) : null}
  </Fragment>
</PersonTree>
