---
import "@daviddef/archive-kit/styles/print.css";
import { versioner } from "@daviddef/archive-kit/lib/assetv.js";
/* every public asset gets a fingerprint, so a fix is never served stale */
const v = versioner();
import { u } from "../lib/url.js";
import SiblingArchives from "@daviddef/archive-kit/components/SiblingArchives.astro";
import SkipLink from "@daviddef/archive-kit/components/SkipLink.astro";
import SocialHead from "@daviddef/archive-kit/components/SocialHead.astro";
import JsonLd from "@daviddef/archive-kit/components/JsonLd.astro";
import VisitCount from "@daviddef/archive-kit/components/VisitCount.astro";
import ring from "@daviddef/archive-kit/data/archives.json";
const { title, description = "", dek, eyebrow, bare, noindex = false } = Astro.props;
const SITE = "The Falco Archive";
const nav = [
  ["Start", [["/", "Home"], ["/about/", "About"], ["/trees/", "The trees"], ["/tree/", "Our line, drawn"], ["/atlas/", "The Atlas"], ["/timeline/", "The Timeline"], ["/dna/", "The DNA"], ["/rule/", "Under Whose Rule"]]],
  ["Our line", [["/direct-line/", "The Spine"], ["/australia/", "Australia"], ["/lines/", "Where they went"]]],
  ["The families", [["/families/", "The Families"], ["/wider-family/", "The Wider Family"], ["/zampiello/", "Zampiello"], ["/annecchino/", "Annecchino"], ["/maione/", "Maione"], ["/ferrara/", "Ferrara"], ["/morgillo/", "Morgillo"], ["/carfora/", "Carfora"], ["/crisci/", "Crisci"], ["/rivetti/", "Rivetti"], ["/liguori/", "The Bishop"]]],
  ["People & places", [["/people/", "The People"], ["/who/", "Every Name"], ["/bloodline/", "Blood relatives, drawn"], ["/register/", "The Register"], ["/households/", "Households"], ["/marriages/", "The Marriages"], ["/graves/", "Graves"], ["/places/", "Places"], ["/walk/", "Walk the Line"], ["/journeys/", "Journeys"], ["/arienzo/", "Arienzo"], ["/camellara/", "Strada Camellara"], ["/valle-caudina/", "Valle Caudina"], ["/diaspora/", "Where the Name Went"]]],
  ["The name", [["/name/", "The Name"], ["/which-falco/", "Which Falco?"], ["/namesakes/", "Namesakes"], ["/arms/", "Arms"]]],
  ["Evidence", [["/method/", "Method"], ["/sources/", "Sources"], ["/searched/", "What Has Been Read"], ["/open-questions/", "Open Questions"], ["/errands/", "Errands"], ["/worklist/", "The work list"], ["/corrections/", "Corrections"], ["/changes/", "What changed"], ["/documents/", "Documents"], ["/gallery/", "Gallery"]]],
  ["Investigations", [["/antenati/", "Antenati"], ["/processetti/", "The Processetti"], ["/holdings/", "Holdings"], ["/the-library/", "The Library"], ["/research-log/", "Research Log"]]],
];

const here = Astro.url.pathname.replace(/\/$/, "");
const on = (h) => here === u(h).replace(/\/$/, "");
/* which of the seven this is, worked out the same way the ring does */
/* WAS a base-keyed find, and base stopped being unique on 12 October 2026.
   Once this archive moved to its own host its base became "", as had
   Defranceschi's, D'Arcy's, Blazevic's and Lerena's — and `find` returned the
   first of them. For about ninety minutes every page of this archive sent its
   visits to thedefranceski.goatcounter.com, because the counter code came
   from the wrong entry. Nothing looked broken: the counter rendered, the
   number was plausible, and it was somebody else's.
   whoami() narrows by origin first (import.meta.env.SITE against each entry's
   url) and falls back to base, so it is right for archives on their own hosts
   AND for the ones still on github.io project paths. The kit fixed its own
   components in e275c14; this layout did its own lookup and was missed.
   The kit exports whoami() from lib/ring.js and this is deliberately the same
   logic rather than that import: ring.js imports archives.json without an
   import attribute, which Astro resolves when the kit's own components pull it
   in relatively but Node's loader rejects through the bare package specifier.
   Three lines copied beats a build that dies on module resolution. */
const _origin = (u) => { try { return new URL(u).origin; } catch { return ""; } };
const _base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
const _site = _origin(import.meta.env.SITE || "");
const _onBase = ring.archives.filter((a) => a.base === _base);
const thisArchive =
  (_site && _onBase.find((a) => _origin(a.url) === _site)) || _onBase[0];

---
<html lang="en" data-base={u("")}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title === SITE ? SITE : `${title} — ${SITE}`}</title>
<meta name="description" content={dek || description} />
<SocialHead title={title} description={dek || description} site={SITE} />
{/* THE KIT'S PRINT STYLESHEET HARD-CODES "daviddef.github.io" as the host it
    prints after every internal link — a plain CSS file cannot know which of
    the eight archives it is in. On this archive that is now wrong on every
    page, and it was found by sweeping the built output for the old host:
    5,956 hits, one per page, all inline in that rule. This overrides it with
    the archive's own origin, taken from the same ring entry the counter and
    the canonical use. The kit's file is shared and is left alone; the fault is
    reported to the sessions that own it. */}
{thisArchive?.url && (
  <style media="print" set:html={`a[href^="/"]::after{content:" (${thisArchive.url.replace(/\/$/, "")}" attr(href) ")" !important}`}></style>
)}
<JsonLd type={bare ? "WebSite" : "Article"} name={title} description={dek || description}
        url={Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname}
        site={SITE} about={Astro.props.person} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{noindex && <meta name="googlebot" content="noindex, nofollow" />}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Libre+Franklin:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
<link rel="stylesheet" href={u("/styles.css") + v("styles.css")} />
</head>
<body class={bare ? "is-home" : ""}>
<SkipLink />
<header class="site">
  <div class="wrap sitein">
    <a class="brand" href={u("/")}>The Falco <em>Archive</em></a>
    <button class="burger" type="button" aria-expanded="false" aria-controls="drawer">
      <span class="bars" aria-hidden="true"></span>Menu
    </button>
    <nav class="topnav" aria-label="Main">
      {nav.map(([label, links]) => (
        <details class="menu">
          <summary>{label}</summary>
          <div class="panel">
            {links.map(([h, l]) => <a href={u(h)} class={on(h) ? "on" : ""}>{l}</a>)}
          </div>
        </details>
      ))}
      <a class="findbtn" href={u("/search/")} aria-label="Search the archive">Search</a>
    </nav>
  </div>
  <div class="drawer" id="drawer" hidden>
    <div class="wrap">{nav.map(([label, links]) => (
      <div class="dgrp"><span class="gl">{label}</span>
        {links.map(([h, l]) => <a href={u(h)} class={on(h) ? "on" : ""}>{l}</a>)}
      </div>
    ))}</div>
  </div>
</header>

<main id="main" tabindex="-1">
  <div class="wrap">
    {!bare && (
      <div class="pagehead">
        {eyebrow && <div class="lab">{eyebrow}</div>}
        <h1>{title}</h1>
        {dek && <p class="dek lead">{dek}</p>}
      </div>
    )}
    <slot />
  </div>
</main>

<footer class="site">
  <div class="wrap">
    <SiblingArchives />
    <p class="foot">An evidence-first archive of the Falco family of Arienzo in the province of Caserta —
    and of Arpaia, Forchia, Benevento and Brisbane. Every claim carries its confidence, or is marked as
    unproven. <strong>Living people are named</strong> — name and relationship only, never a date, a place, a photograph or a record.</p>
    <p class="foot dim">Built {new Date().getFullYear()} ·
      <a href={u("/documents/")}>Documents</a> ·
      <a href={u("/sources/")}>Sources</a> ·
      <a href={u("/method/")}>Method</a> ·
      <a href={u("/open-questions/")}>Open questions</a> ·
      <a href={u("/corrections/")}>Corrections</a> ·
      <a href="https://github.com/daviddef/TheFalco">The repository</a> ·
      Corrections are the most valuable thing you can send</p>
    <VisitCount code={thisArchive?.counter} />
  </div>
</footer>

<script is:inline>
  (function () {
    var bar = document.querySelector(".topnav");
    var burger = document.querySelector(".burger");
    var drawer = document.getElementById("drawer");
    if (burger && drawer) {
      burger.addEventListener("click", function () {
        var open = drawer.hasAttribute("hidden");
        if (open) { drawer.removeAttribute("hidden"); } else { drawer.setAttribute("hidden", ""); }
        burger.setAttribute("aria-expanded", open ? "true" : "false");
      });
    }
    if (!bar) return;
    var menus = [].slice.call(bar.querySelectorAll("details.menu"));
    menus.forEach(function (d) {
      d.addEventListener("toggle", function () {
        if (!d.open) return;
        menus.forEach(function (o) { if (o !== d) o.open = false; });
      });
    });
    document.addEventListener("click", function (e) {
      if (e.target.closest(".topnav")) return;
      menus.forEach(function (d) { d.open = false; });
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") menus.forEach(function (d) { d.open = false; });
    });
  })();
</script>
</body>
</html>
