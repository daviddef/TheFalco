---
/* The box is one component in @daviddef/archive-kit, shared by all seven
   archives. What stays here is what belongs to this archive: how it describes
   itself, and the things worth trying. */
import Base from "../layouts/Base.astro";
import Search from "@daviddef/archive-kit/components/Search.astro";
import { u } from "../lib/url.js";
import idx from "../data/searchindex.json";
const hints = [["Arienzo", "the valley they never left"], ["Pasquale", "the 1767 baptism"], ["processetti", "the marriage files"], ["Zampiello", "one of the families married in"], ["Sant'Andrea", "the church still standing"], ["1957", "the year they sailed"]];
---
<Base title="Search" eyebrow={`${idx.length.toLocaleString()} things, one box`} dek="Every page, every person, every name, every source and every plate — searchable in one place." noindex={true}>
  <section class="blk">
    <Search base={u("/")} hints={hints} placeholder="Arienzo · Pasquale · processetti · Valle Caudina · 1767" />
    <p class="dek" style="margin-top:1.4rem">This searches <strong>what the archive says</strong>,
    not the registers themselves. A name that returns nothing here has not been read yet — which is
    itself worth knowing. <a href={u("/searched/")}>What has already been looked for &rarr;</a></p>
  </section>
</Base>
