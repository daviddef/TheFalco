---
import Base from "../layouts/Base.astro";
import Spine from "@daviddef/archive-kit/components/Spine.astro";
import P from "../components/P.astro";
import { u } from "../lib/url.js";
import { md } from "@daviddef/archive-kit/lib/md.js";
import line from "../data/line.json";
import { people } from "../lib/people.js";
/* Whether a generation is living is decided by the person graph, not by a hand
   flag in line.json. line.json marked only generation nine, so generation
   EIGHT — alive, and with a birth date in the file — was being published in
   full. The graph applies one rule to everybody; this page follows it. */
const livingGen = new Set(people.filter((p) => p.living && p.gen).map((p) => p.gen));
const shown = line.map((g) => ({ ...g, living: g.living || livingGen.has(g.gen) }));
const clean = s => String(s||"").replace(/\s*\(.*?\)\s*/g," ").replace(/\s+/g," ").trim();
const slugFor = (g) => {
  const p = people.find(q => q.gen === g.gen && clean(q.name) === clean(g.name));
  return p ? p.slug : null;
};
const heading = (g) => g.spouse ? `${g.name} and ${g.spouse}` : g.name;

/* «and why no links for the wives?» — 22 September. Because line.json
   carries her as a name and nothing else, while the husband arrives with
   an identifier. Five of the nine wives do have a page in this archive and
   were being drawn as plain text beside a linked husband.

   MATCHED ONLY WHERE EXACTLY ONE PERSON BEARS THE NAME, and counted at
   build time rather than written down, so the day a second Francesca
   Zampiello enters people.json the link disappears instead of quietly
   pointing at the wrong woman. This archive has two Raffaele Falcos and
   two Carmine Antonios on the spine alone; a name is not an identity here.
   The husband's own link is safe for the opposite reason — `slugFor`
   matches on GENERATION AND NAME together. */
const SPOUSE_SLUG = (() => {
  /* people.json WRITES A MARRIED WOMAN "Maiden (Married)" — "Giovanna
     Arricole (Falco)", "Constanza Maione (Falco)" — while line.json writes
     her maiden name alone, so plain equality missed every wife who took
     the surname.

     TWO MAPS, TRIED IN ORDER, NOT ONE MAP WITH BOTH KEYS IN IT. The first
     attempt keyed every person under their full name and their name minus
     the parenthetical, in a single map — which let "Francesca Crisci
     (Falco)" collide with a different woman actually named Francesca
     Crisci and poison a key that had been matching correctly. Five links
     became one. An exact name is better evidence than a stripped one, so
     it is asked first and only falls through when it finds nothing. */
  const bare = (n) => String(n || "").replace(/\s*\([^)]*\)\s*$/, "").trim();
  const exact = new Map(), loose = new Map();
  const put = (m, k, slug) => { if (k) m.set(k, m.has(k) ? null : slug); };
  for (const p of people) {
    put(exact, String(p.name || "").trim(), p.slug);
    const b = bare(p.name);
    if (b && b !== String(p.name || "").trim()) put(loose, b, p.slug);
  }
  /* A KEY WITH TWO BEARERS IS POISONED, NEVER PICKED BETWEEN. Three people
     here are called Andreana Crisci — generation three's wife, a daughter
     named after her, and an unrelated woman — so generation three keeps a
     name and no link, which is the right answer. This archive has two
     Raffaele Falcos and two Carmine Antonios on the spine alone; a link to
     the wrong woman is worse than no link at all. */
  return (name) => {
    const n = String(name || "").trim();
    // "Chiara Rivetti / Rivotti" offers two spellings; try each.
    const keys = [n, ...n.split("/").map((x) => x.trim())].filter(Boolean);
    for (const k of keys) { const s = exact.get(k); if (s) return s; }
    for (const k of keys) { const s = loose.get(k); if (s) return s; }
    return null;
  };
})();
const withSpouse = (g) => ({
  ...g,
  spouseHref: SPOUSE_SLUG(g.spouse) ? `/people/${SPOUSE_SLUG(g.spouse)}/` : null,
});

---
<Base title="The Spine"
      eyebrow="Nine generations, the ninth living and named"
      dek="From the Arienzo of the 1730s to Brisbane. Each generation is joined to the one above it by a record that names a father — except the first, where the line stops.">

  <Spine u={u} archiveKey="falco" rows={shown.map(withSpouse).map((g) => ({
    gen: g.gen,
    name: g.name,
    spouse: g.spouse,
    href: slugFor(g) ? "/people/" + slugFor(g) + "/" : "",
    born: g.born, bornPlace: g.bornPlace,
    died: g.died, diedPlace: g.diedPlace,
    living: g.living,
    /* line.json holds these and the spine was not passing them: a trade for
       three generations, a marriage date for five. `slugFor` above matches
       on GENERATION AND NAME, which is what keeps the two Raffaele Falcos —
       four and six, grandfather and grandson — pointing at two pages. */
    trade: g.trade || "",
    married: g.married || "",
    confidence: g.confidence,
    weak: g.gen === 1,
    weakNote: "The line stops here: no record names this man's father.",
    note: g.note || "",
  }))} />

  <h2>The welds</h2>
  <p>A pedigree is only as good as its joins. Four records carry this one.</p>
  <div class="scroll"><table>
    <thead><tr><th>Record</th><th>Date</th><th>What it says</th><th>Joins</th></tr></thead>
    <tbody>
      <tr><td>Death of Vincenzo Falco</td><td>15 May 1875, Arienzo</td>
        <td>Names his father as <strong>Pasquale</strong></td><td>gen 3 → gen 2</td></tr>
      <tr><td>Death of Raffaele Falco</td><td>21 Apr 1880, Arienzo</td>
        <td>Names his father as <strong>Vincenzo</strong></td><td>gen 4 → gen 3</td></tr>
      <tr><td>Birth of Carmine Antonio Falco</td><td>10 Jul 1850, Arienzo</td>
        <td>Names his father as <strong>Raffaele</strong></td><td>gen 5 → gen 4</td></tr>
      <tr><td><strong>Death of Pasquale Falco</strong></td><td>1 Oct 1834, Arienzo</td>
        <td>Names his parents as <P n="Matteo Falco" bold={true} /> and <P n="Francesca Crisci" bold={true} />,
        and his wife as <P n="Chiara Rivetti" bold={true} /></td><td>gen 2 → gen 1</td></tr>
      <tr><td><strong>Death of Rosa Falco</strong>, his sister</td><td>16 Oct 1830, Arienzo</td>
        <td>Names the <strong>same two parents</strong> again, from a different child, four years
        earlier — and her husband as <P n="Carlantonio Morgillo" bold={true} /></td>
        <td>gen 2 → gen 1, twice over</td></tr>
    </tbody>
  </table></div>
  <p class="small">Generation 2 is welded upward three times: by Pasquale's baptism of 1767 in the
  parish register; by his own civil death act of 1834; and by his sister Rosa's civil death act of
  1830. One parish record and two civil ones, from two archives.
  <strong>Above Matteo there is nothing.</strong> His marriage to Francesca Crisci would name his
  father; it was searched for across 2,056 transcribed pages and not found, and his own baptism falls
  in the gap the register leaves between 1738 and 1761. That is the frontier of this research. See
  <a href={u("/open-questions/")}>Open questions</a>.</p>
</Base>

<style>
  .dline{position:relative;margin:1.6rem 0 2.6rem;padding-left:2.9rem}
  .dline::before{content:"";position:absolute;left:.6rem;top:1.1rem;bottom:2.2rem;width:1px;
    background:var(--rule-strong)}
  .dgen{scroll-margin-top:4rem;position:relative;padding:0 0 1.6rem;margin-bottom:1.6rem;border-bottom:1px solid var(--rule)}
  .dgen:last-child{border-bottom:0;margin-bottom:0}
  .dgen::before{content:"";position:absolute;left:-2.6rem;top:.35rem;width:.72rem;height:.72rem;
    border-radius:50%;background:var(--ground);border:2px solid var(--accent-2)}
  .dgen:target h2{color:var(--accent)}
  .dgen.frontier::before{border-color:var(--accent);border-style:dashed}
  .dgen h2{font-size:clamp(22px,3vw,31px);margin:.25rem 0 .5rem;line-height:1.12}
  .dgen h2 a{color:var(--ink);text-decoration:none}
  .dgen h2 a:hover{color:var(--accent)}
  .dgen .facts{font-family:var(--sans);font-size:13px;color:var(--ink-2);
    display:flex;flex-wrap:wrap;gap:.35rem 1.15rem;align-items:center;margin-bottom:.7rem}
  .dgen .facts .k{font-size:10px;font-weight:600;letter-spacing:.13em;text-transform:uppercase;
    color:var(--ink-3);margin-right:.4rem}
  .dgen .tale{max-width:74ch}
</style>
