---
/* A part opener: the part's paragraph, its chapters, and the way in. One page per part of src/data/book.json. */
import Base from "../../layouts/Base.astro";
import BookPart from "@daviddef/archive-kit/components/BookPart.astro";
import { u } from "../../lib/url.js";
import book from "../../data/book.json";

export function getStaticPaths() {
  return book.parts.map((part) => ({ params: { id: part.id }, props: { part } }));
}
const { part } = Astro.props;
---
<Base title={part.title}
      eyebrow="The Falco Archive, as one book"
      dek={`The ${part.chapters.length} chapters of part ${part.numeral}, in the order they are read.`}>
  <BookPart book={book} id={part.id} u={u} />
</Base>
