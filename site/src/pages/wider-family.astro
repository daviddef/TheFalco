---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import households from "../data/households.json";
import { findPerson } from "../lib/people.js";
import HouseholdTree from "../components/HouseholdTree.astro";
import P from "../components/P.astro";
import Src from "../components/Src.astro";
import line from "../data/line.json";
import allPeople from "../data/people.json";

/* WHO IS ON THE LINE IS READ FROM THE PERSON GRAPH, NOT FROM A NAME.
   The graph (tools/build_people.py) marks a person `line` only when the
   generation's ancestor AND spouse both match, so a household is a line
   household when the graph files a line person under it. Matching the bare
   name instead put 16 households here because a different man of the same
   forename and surname is a child in them (two Raffaele, two Matteo, three
   Vincenzo, a second Carmine Antonio). */
const lineHeadGen = new Map();          // household id -> generation of its line head
for (const p of allPeople) {
  if (p.line && p.hid && ["father", "head", "mother"].includes(p.role)) {
    lineHeadGen.set(p.hid, Math.min(lineHeadGen.get(p.hid) ?? 99, p.gen));
  }
}
const norm = (s) => String(s || "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().replace(/\s+/g, " ").trim();
/* The ways one man's name is written. «Pasquale (Pascuale) Falco» is spelt two
   ways; «Raffaele Falco (the first, 1816-1817)» is a DIFFERENT man, and a
   bracket with a year, «of» or «the» in it never makes a variant spelling. */
const forms = (s) => {
  const raw = String(s || "").replace(/\s+/g, " ").trim();
  const m = raw.match(/^(.*?)(\S+)\s*\(([^)]*)\)\s*(.*)$/);
  if (!m) return new Set([norm(raw)]);
  if (/\d|\b(the|of|first|second|elder|younger)\b/i.test(m[3])) return new Set();
  return new Set([norm(`${m[1]}${m[2]} ${m[4]}`), norm(`${m[1]}${m[3]} ${m[4]}`)]);
};
const sameMan = (a, b) => { const fb = forms(b); return [...forms(a)].some((x) => fb.has(x)); };
const lineAt = (g) => line.find((x) => x.gen === g);
/* the line person a household member IS: the head of a line household, or the
   child of a line head who carries on the line */
const lineGenOf = (h, m) => {
  const g = lineHeadGen.get(h.id);
  if (!g) return null;
  if (m.role === "father" && lineAt(g) && sameMan(m.person, lineAt(g).name)) return g;
  if (m.role === "child" && lineAt(g + 1) && sameMan(m.person, lineAt(g + 1).name)) return g + 1;
  return null;
};
const isLineMember = (h, m) => lineGenOf(h, m) !== null;

const total = households.reduce((a, h) => a + h.members.length, 0);
const people = new Set();
households.forEach(h => h.members.forEach(m => people.add(m.person)));
// the generations of the line that these households actually hold, each counted once
const lineGensHeld = new Set();
households.forEach(h => h.members.forEach(m => { const g = lineGenOf(h, m); if (g) lineGensHeld.add(g); }));
const collateral = { length: people.size - lineGensHeld.size };

/* HOUSEHOLDS OF PROVED KIN: no person of the line is in them, but a record ties each to the line.
   They are the households listed under «The line» on /which-falco that are not line households.
   Hand-kept here, with the record that does it, as which-falco's own lists are. */
const KIN = [
  { id: "giuseppe-falco-antonia-di-guida",
    why: "Giuseppe Falco is a son of Matteo Falco and Francesca Crisci: the parish baptism calls him «filium Matthei, e Franciscae Crisci», and the civil acts of 1810 and 1811 write him «del fu Matteo». A brother of generation two." },
  { id: "gioacchino-falco-strada-camellara",
    why: "Gioacchino Falco is a son of Matteo Falco and Francesca Crisci: the index to the Arienzo deaths of 1851 names his parents so. Also a brother of generation two." },
  { id: "francesco-falco-raffaela-falco",
    why: "Francescantonio Falco, son of Pasquale Falco and Chiara Rivetti (generation two), married Raffaela Falco, daughter of Giuseppe Falco and Antonia di Guida, in 1832. Their children are grandchildren of Matteo Falco through both of his sons." },
  { id: "pasquale-falco-maria-amalia-guida",
    why: "Pasquale Falco is the son of Francesco Falco and Raffaela Falco: his death act of 26 September 1883 names his parents, which places him in the household above." },
  { id: "michelangelo-falco-mariantonia-vigliotta",
    why: "On 4 May 1831 the clerk of the Arienzo death register recorded Vincenzo Falco of this line as «parente della defunta» at the death of Michelangelo's thirteen-month-old daughter Anna. The degree is not stated." },
];
const kin = { households: KIN };
const kinIds = new Map(kin.households.map(k => [k.id, k.why]));
// households that hold a person of the direct line
const lineHouseholds = households.filter(h => lineHeadGen.has(h.id));
// households of proved kin: a record ties them to the line, but no line person is in them
const kinHouseholds = households.filter(h => !lineHeadGen.has(h.id) && kinIds.has(h.id));
// everything else: no record joins it to the line
const sideBranches = households.filter(h => !lineHeadGen.has(h.id) && !kinIds.has(h.id));
const hasFalcoName = (h) => /\bFalco\b/.test(h.name);
const falcoHeaded = sideBranches.filter(h => /\bFalco\b/.test(String(h.name).split("&")[0])).length;
const falcoNamed = sideBranches.filter(hasFalcoName).length;
const noFalco = sideBranches.length - falcoNamed;
const atArienzo = sideBranches.filter(h => h.members.some(m => /Arienzo/.test(m.place || ""))).length;
---
<Base title="The wider family">
  <p class="lede">This archive is not a pedigree. A pedigree keeps one child in each generation and
  discards the rest; most of the people here were discarded by that logic and are recorded anyway —
  the brothers and sisters, the households that never left Arienzo, and the Falco who are plainly
  related to this family but cannot yet be joined to it.</p>

  <div class="grid two">
    <div class="card">
      <h3>{people.size} people</h3>
      <p>documented across <strong>{households.length} households</strong> and
      <strong>{total} register entries</strong>.</p>
    </div>
    <div class="card">
      <h3>{collateral.length} of them</h3>
      <p>are <strong>not</strong> in the direct line. The line is {line.length} people, one to a generation; nearly
      everything else on this site is somebody else's family.</p>
    </div>
  </div>

  <h2 id="san-felice">A Falco household at San Felice a Cancello</h2>
  <div class="card" style="margin-bottom:1.2rem">
    <p><strong>Found on 13 September 2026, in the Arienzo marriage register of 1815.</strong>
    <P n="Luigi Falco" bold={true} />, eighteen, a <strong><em>sapunaro</em> — a soap-maker</strong>,
    married at Arienzo that year. He was a minor, so his parents had to consent and the act names
    them: <strong>SEBASTIANO FALCO</strong>, of the same trade, and <strong>COLOMBA
    MONTEFUSCO</strong>, fifty-five, a <em>filatrice</em>.
    <Src plate="luigi-falco-marriage-1815.jpg" label="the act" /></p>
    <p style="margin-top:.6rem"><strong>They do not live at Arienzo.</strong> The act puts them in
    the «<strong>Comune de' SEI CASALI</strong>» — the Six Hamlets of Arienzo, which is the name
    <a href={u("/morgillo/")}>San Felice a Cancello</a> uses for itself in its own registers — on
    <strong>strada Croce di San Felice</strong>.</p>
  </div>
  <h3>Their marriage file, found by sweeping all 385 images</h3>
  <p>The 1815 processetti hold <strong>twenty-five bundles</strong> for the year's twenty-five
  marriages. <strong>They are not bound in numeric order</strong> — bundle 1 sits at image 20 and
  bundle 2 at image 3, bundle 4 at 106 and bundle 5 at 90 — so sampling the first few covers and
  extrapolating reaches nothing. Luigi Falco's is <strong>bundle 8, at image 123</strong>, and only a
  sweep of the whole volume found it. <Src plate="luigi-falco-processetto-1815.jpg" label="the cover" /></p>

  <div class="card" style="margin:1.1rem 0;border-left:3px solid var(--accent)">
    <p><strong>And it gives his baptism.</strong> «…Parochus Ecclesiae Parochialis <strong>S. FELICIS
    MARTYRIS</strong> hujus Terrae Argentii, <strong>Diocesis S. AGATHAE GOTHORUM</strong> … libro VII
    baptizatorum … fol. 148 … <strong>Die vigesima septima mensis Februarii … 1797</strong> … sacro
    fonte expiavit infantem natum ex legitimis Conjugibus <strong>SEBASTIANO FALCO</strong> et
    <strong>COLUMBA MONTEFUSCO</strong>.» <Src plate="luigi-falco-baptism-1797.jpg" label="the extract" /></p>
    <p class="small"><strong>Luigi Falco was baptised 27 February 1797</strong> — exactly what his
    stated age of eighteen implies. And the extract names the jurisdiction: the San Felice Falco
    belonged to the parish of <strong>San Felice Martire</strong>, in the <strong>diocese of
    Sant'Agata de' Goti</strong>, whose books this archive has never worked in.</p>
  </div>

  <p><strong>A third name for the same town.</strong> The banns were published not at Arienzo but by
  the sindaco of the «<strong>Comune de' CASALI UNITI d'Arienzo</strong>», who calls Luigi «nativo, e
  domiciliato in questa detta Comune … <strong>strada detta la Croce</strong>». Its own clerks also
  call it the <em>Comune de' sei Casali d'Arienzo</em>; Antenati catalogues it as <em>San Felice
  (oggi San Felice a Cancello)</em>. <strong>Any one of the three will hide it from a search for the
  others</strong>, which is most of why it stayed lost.</p>

  <div class="card" style="margin:1.1rem 0">
    <p><strong>What the file does not contain, and why that is informative.</strong> It names no
    grandparent — and the absence is structural, not accidental. <strong>Both of Luigi's parents were
    alive and consented in person</strong>, so the Code required no death certificates on his side.
    (Compare bundle 13 of 1814, where the bride's parents and grandfather were all dead and their
    extracts reach back to 1789.) <strong>The route to Sebastiano Falco's own parents is therefore a
    death act for him or for Colomba</strong>, in San Felice's registers — now reachable, and with
    twenty-seven index volumes to search instead of the registers themselves.</p>
  </div>

  <p><strong>Why that matters, and how far it does not.</strong> Generation four's wife,
  <P n="Angela Rosa Morgillo" bold={true} />, <strong>was born at San Felice on 24 February
  1818</strong> — three years after this act, in the town where these Falco were living. This
  archive had always treated San Felice as somewhere the family merely married into. There were
  Falco there.</p>
  <div class="card" style="margin:1.1rem 0">
    <p><strong>No connection to this line is claimed, and the trade argues against one.</strong>
    Every Falco this archive has traced is a <em>contadino</em>, a <em>colono</em> or a
    <em>bracciale</em> — people of the land. Sebastiano and Luigi make soap. A shared surname in one
    district is suggestive and is not evidence, and that rule is not suspended because the
    coincidence is a pleasing one.</p>
    <p class="small"><strong>What would test it:</strong> a death act for Sebastiano or Colomba in
    San Felice's own registers — newly reachable — naming Sebastiano's parents; Luigi's baptism,
    about 1797; and the processetto for this marriage, which carries both baptism extracts.</p>
  </div>

  <h2 id="line-households">Households the line passes through</h2>
  <p>These {lineHouseholds.length} households each hold a person of the direct line, filed there by
  the person graph and not by a shared name. In each, one child continued the line and the others
  did not. The others are here.</p>
  {lineHouseholds.map(h => {
    const sibs = h.members.filter(m => m.role === "child" && !isLineMember(h, m));
    return (
      <section class="card" id={h.id} style="margin:1rem 0">
        <h3 style="margin-bottom:.3rem">{h.name}</h3>
        <p class="small" style="margin:.1rem 0 .6rem">
          {h.members.length} entries · {sibs.length} {sibs.length === 1 ? "child" : "children"} outside the line
        </p>
        {sibs.length ? (
          <ul style="margin:.3rem 0">
            {sibs.map(m => (
              <li>
                <strong>{(findPerson(m.person, h.name)||{}).slug ? <a href={u("/people/" + findPerson(m.person, h.name).slug)}>{m.person}</a> : m.person}</strong>
                {m.event && m.date ? <span class="small"> — {m.event}, {m.date}</span> : null}
              </li>
            ))}
          </ul>
        ) : <p class="small" style="margin:.2rem 0">No siblings recorded yet.</p>}
      </section>
    );
  })}

  <h2 id="kin">Households of proved kin</h2>
  <p>No person of the direct line is in any of these {kinHouseholds.length}, but a record of this
  archive ties each to the line as kin. They are the households listed under
  <a href={u("/which-falco/")}>The line</a> on <em>Which Falco?</em> that are not in the section above.</p>
  {kinHouseholds.map(h => (
    <section class="card" id={h.id} style="margin:1rem 0">
      <h3 style="margin-bottom:.3rem">{h.name} <span class="chip">kin</span></h3>
      <p class="small" style="margin:.1rem 0 .6rem">{kinIds.get(h.id)}</p>
      <HouseholdTree household={h} showHead={false} />
      <ul style="margin:.4rem 0">
        {h.members.map(m => (
          <li>
            <strong>{(findPerson(m.person, h.name)||{}).slug ? <a href={u("/people/" + findPerson(m.person, h.name).slug)}>{m.person}</a> : m.person}</strong> <span class="small">({m.role})</span>
            {m.event && m.date ? <span class="small"> — {m.event}, {m.date}</span> : null}
            {m.place ? <span class="small">, {m.place}</span> : null}
          </li>
        ))}
      </ul>
    </section>
  ))}

  <h2 id="unjoined">Households not yet joined to the line</h2>
  <p>This archive holds {sideBranches.length} households that no record joins to the direct line, and
  it does not join them by assumption. {falcoHeaded} are headed by a man named Falco and
  {falcoNamed - falcoHeaded} by a woman of the name who married out; the other {noFalco} carry no
  Falco in the household's name or among its members. {atArienzo} of the {sideBranches.length} have a member recorded at Arienzo; the rest are
  recorded only at San Felice a Cancello, Santa Maria a Vico, Forchia, Arpaia, Brisbane and
  elsewhere. They are published so that somebody with the missing act can join them, or rule them
  out.</p>
  {sideBranches.map(h => (
    <section class="card" id={h.id} style="margin:1rem 0">
      <h3 style="margin-bottom:.3rem">{h.name} <span class="chip dis">unjoined</span></h3>
      <HouseholdTree household={h} showHead={false} />
      <ul style="margin:.4rem 0">
        {h.members.map(m => (
          <li>
            <strong>{(findPerson(m.person, h.name)||{}).slug ? <a href={u("/people/" + findPerson(m.person, h.name).slug)}>{m.person}</a> : m.person}</strong> <span class="small">({m.role})</span>
            {m.event && m.date ? <span class="small"> — {m.event}, {m.date}</span> : null}
            {m.place ? <span class="small">, {m.place}</span> : null}
          </li>
        ))}
      </ul>
    </section>
  ))}

  <h2>Where this is thin, and honestly so</h2>
  <p>The collateral work is strong for Arienzo in the seventeen and eighteen hundreds, and weak after
  it. Two gaps are worth naming rather than papering over:</p>
  <ul>
    <li><strong>The siblings who stayed in Italy.</strong> Raffaele Falco and Costanza Maione had
    children at Arienzo in 1898 and 1913 besides Carminantonio, who left. What became of them, and of
    their descendants, is not traced. There are almost certainly Falco cousins in Campania today.</li>
    <li><strong>The generation that emigrated is only half followed.</strong> Carminantonio's son
    Raffaele reached Brisbane too, married Caterina Zampiello, and is buried at Nudgee — he is
    recorded, but his family is not worked through. Four Zampiello sisters reached Queensland; two of
    them married out, into <em>Servodio</em> and <em>Miceli</em>, and those lines are named and then
    dropped. See <a href={u("/australia/")}>the Australian chapter</a>.</li>
  </ul>
  <p>Both are ordinary research, not blocked doors. They are listed among the
  <a href={u("/open-questions/")}>open questions</a> so they are not quietly forgotten.</p>

  <p class="small">Every person above is carried with the words of the record that names them, in
  <a href="https://github.com/daviddef/TheFalco/blob/main/data/households.tsv">households.tsv</a>.
  The full household detail is on <a href={u("/households/")}>The households</a>.</p>
</Base>
