---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import P from "../components/P.astro";
import Src from "../components/Src.astro";
import dna from "../data/dna.json";
import line from "../data/line.json";

const [carmine, francesca] = dna.people;
const groups = [...new Set(dna.people.flatMap((p) => p.ethnicity.map((e) => e.group)))]
  .sort((a, b) => (carmine.ethnicity.find(e=>e.group===b)?.pct||0) + (francesca.ethnicity.find(e=>e.group===b)?.pct||0)
                - (carmine.ethnicity.find(e=>e.group===a)?.pct||0) - (francesca.ethnicity.find(e=>e.group===a)?.pct||0));
const pct = (p, g) => (p.ethnicity.find((e) => e.group === g) || {}).pct || 0;

const allFits = dna.people.flatMap((p) => p.notable.map((n) => n.fit));
const best = Math.min(...allFits);
const FLOOR = 1.0;                       // the reporting floor on these estimates

/* The tested generation is eight. Autosomal DNA halves at every step, so the
   share a given ancestor still contributes to Carmine is 1/2^n. */
const horizon = line.filter((g) => g.gen <= 8).sort((a, b) => b.gen - a.gen)
  .map((g) => ({ ...g, steps: 8 - g.gen, share: 100 / Math.pow(2, 8 - g.gen) }));
const belowFloor = horizon.filter((h) => h.share < FLOOR);
const shared = carmine.notable.filter((a) => francesca.notable.some((b) => b.name === a.name));
---
<Base title="What the DNA says"
      eyebrow="Two tests, generation eight"
      dek="Carmine Falco and Francesca Zampiello were tested. The result is not a surprise — it is a confirmation — and the two most useful things on this page are what the test refuses to claim and how far back it can see.">

  <div class="card" style="margin-bottom:1.2rem">
    <p><strong>Why these results are here at all.</strong> This archive publishes nothing but a name
    and a relationship for a living person, and DNA sits further inside that line than a birth date.
    <strong><P n="Carmine Falco">Carmine Falco</P> died in 2026</strong> and
    <strong><P n="Francesca Zampiello (Falco)">Francesca Zampiello</P> on 10 September 2022</strong>.
    <strong>No living person's DNA appears on this site</strong>, and none will.</p>
    <p class="small">{dna.test}. Read {dna.read}.
    <Src label="MyHeritage, not linked" note="The results sit behind a private MyHeritage account. Every figure is transcribed here in full so the reasoning can be checked; the account itself is not public." /></p>
  </div>

  <div class="card" style="margin-bottom:1.4rem;border-left:3px solid var(--ochre)">
    <p><strong>A fourth grade, and it ranks below the others.</strong> This archive marks every claim
    <span class="chip doc">documented</span> <span class="chip inf">inferred</span>
    <span class="chip lore">family lore</span>. Everything on this page carries a new one —
    <span class="chip dna">dna</span> — and it sits <strong>below <em>documented</em></strong>, because
    <strong>a register entry names a person and an estimate names a probability</strong>. An ethnicity
    estimate is not a document. It is a statistical fit of one genome against reference panels of
    living people, printed to one decimal place because the software can, not because the world is
    that precise.</p>
  </div>

  <h2>The headline is that there isn't one</h2>
  <p class="lede">Two people born <strong>eight kilometres apart</strong> — Arienzo and Arpaia —
  who married in 1955. At the resolution this test offers, <strong>they are the same person.</strong></p>

  <div class="dnabars">
    {groups.map((g) => {
      const a = pct(carmine, g), b = pct(francesca, g);
      return (
        <div class="row">
          <div class="nm">{g === "South Italian" ? <strong>{g}</strong> : g}</div>
          <div class="pair">
            <div class="bwrap">{a ? <div class="bar c" style={`width:${a}%`}></div> : null}<span class="v">{a ? a.toFixed(1) + "%" : "not reported"}</span></div>
            <div class="bwrap">{b ? <div class="bar f" style={`width:${b}%`}></div> : null}<span class="v">{b ? b.toFixed(1) + "%" : "not reported"}</span></div>
          </div>
          <div class="dv">{a && b ? (Math.abs(a - b)).toFixed(1) + " pts" : "—"}</div>
        </div>
      );
    })}
    <p class="key"><span class="sw c"></span> Carmine, Arienzo 1930 &nbsp;
       <span class="sw f"></span> Francesca, Arpaia 1928 &nbsp; · &nbsp; right-hand column: the gap</p>
  </div>

  <p><strong>Both come back around eighty per cent South Italian, and the model pins both to the same
  sub-region — <em>Campania</em>.</strong> Every other difference above is smaller than the wobble
  between one version of an ethnicity model and the next.</p>

  <div class="card" style="margin:1.1rem 0">
    <p><strong>That sameness is the finding, and the registers explain it.</strong> The sweeps count
    <strong>eleven marriages between Falco and Crisci alone</strong>. Two Zampiello sisters married two
    Falco brothers. The same twenty-odd surnames — Cioffi, Morgillo, Martone, Giglio, Zimbardo,
    Sepistella — fill two hundred years of one town's death register, and
    <strong>strada Camellara holds Falco, Cioffi, Morgillo and Carfora households at once</strong>.</p>
    <p><strong>This is what endogamy looks like from inside a genome.</strong> The DNA is not telling
    the archive anything new; it is measuring, from the other end, the same closed valley the
    <a href={u("/register")}>register</a> has been documenting act by act. <strong>A confirmation is a
    result</strong>, and this archive publishes those too.</p>
  </div>

  <h2>The horizon — and why generation one is invisible</h2>
  <p class="lede">This is the most useful thing on the page. <strong>Autosomal DNA halves at every
  generation, and it halves fast.</strong> The reporting floor on these estimates is about
  <strong>1%</strong>. Read the direct line with that in mind.</p>

  <div class="scroll"><table class="hz">
    <thead><tr><th>Gen</th><th>Ancestor</th><th>Born</th><th>Steps back</th><th>Share still in Carmine</th></tr></thead>
    <tbody>
      {horizon.map((h) => (
        <tr class={h.share < FLOOR ? "floor" : (h.gen === 8 ? "self" : "")}>
          <td class="mono">{h.gen}</td>
          <td>{h.gen === 8 ? <strong>{h.name} — the man tested</strong> : (h.living ? h.name : <strong>{h.name}</strong>)}</td>
          <td class="mono small">{h.living ? "living" : (h.born || "—")}</td>
          <td class="mono">{h.steps}</td>
          <td class="mono">{h.share.toFixed(3)}%{h.share < FLOOR ? <span class="chip lore" style="margin-left:.4rem">below the floor</span> : null}</td>
        </tr>
      ))}
    </tbody>
  </table></div>

  <div class="card" style="margin:1.1rem 0;border-left:3px solid var(--accent)">
    <p><strong>{belowFloor.map(h => h.name).join(", ")} — the founding ancestor of this whole archive —
    contributes about {belowFloor[0] ? belowFloor[0].share.toFixed(2) : "0.78"}% of Carmine's genome.
    That is beneath what the test can report.</strong> Generation two, <strong>Pasquale Falco</strong>,
    sits at <strong>1.56%</strong> — right on the edge of it.</p>
    <p><strong>So the DNA and the registers are not two views of the same distance.</strong> The paper
    reaches <a href={u("/direct-line")}>nine generations, to a man born by about 1735</a>. The DNA
    reaches about six, to roughly <strong>1790</strong>. Where they overlap — generations three to
    eight, Arienzo and the Valle Caudina — <strong>they agree exactly</strong>. Beyond that overlap the
    test has nothing whatever to say, and <strong>an absence in it is a fact about the test, not about
    the family.</strong></p>
  </div>

  <h2>What this does <em>not</em> mean</h2>
  <p>Both profiles carry small Eastern Mediterranean and North African components —
  <strong>Syrian {pct(carmine,"Syrian")}% and {pct(francesca,"Syrian")}%</strong>, Egyptian, Armenian,
  Tunisian. The obvious reading is a Syrian ancestor, an Egyptian great-grandmother.
  <strong>That reading is wrong.</strong></p>
  <ul>
    <li><strong>Campania was Greek before it was Roman.</strong> Cumae was settled in the eighth
    century BC; <em>Naples</em> is a Greek name. A Greek component in a Campanian is not an immigrant
    ancestor — it is the population itself.</li>
    <li><strong>The whole Mediterranean basin is in these percentages.</strong> Phoenician, Greek,
    Roman, Byzantine, Arab and Norman contact across three thousand years leaves exactly this kind of
    small, broad Levantine and North African signal in southern Italian reference panels.
    <strong>A five per cent «Syrian» reading is a statement about the Bronze Age, not about a
    great-great-grandparent</strong> — and by the table above, no individual ancestor that recent could
    show up at five per cent anyway.</li>
    <li><strong>These are the least stable numbers in the test</strong>, the ones that move when the
    vendor changes model version — which is why <strong>v2.5</strong> is recorded at the top of this
    page rather than left out.</li>
    <li><strong>«Greek and Albanian» is one cluster, not two.</strong> The test cannot separate them,
    so neither can this page.</li>
  </ul>

  <h2>The «Notable Individuals», and the number nobody reads</h2>
  <p class="lede">Both results offer a ranked list of famous ancient and historical people
  «most similar to you genetically». <strong>On the vendor's own scale, not one of them is a match.</strong></p>

  <div class="fitscale">
    {dna.fitScale.map((f) => (
      <span class={"fb " + f.band.toLowerCase().replace(/\s+/g, "")}>
        <strong>{f.band}</strong> <span class="mono">{f.range}</span>
      </span>
    ))}
    <span class="note">lower is closer</span>
  </div>

  <p><em>“{dna.fitDefinition}”</em> — the test's own words.
  <strong>All {allFits.length} entries across both lists score above 5.0. The closest is
  {" " + best}.</strong> Every single one falls in the <strong>«Distant»</strong> band. The list is a
  ranking of things that do not match, ordered by how much they do not match.</p>

  <div class="scroll"><table>
    <thead><tr><th>Notable individual</th><th>Where and when</th><th>Carmine</th><th>Francesca</th><th>Band</th></tr></thead>
    <tbody>
      {[...new Set(dna.people.flatMap(p=>p.notable.map(n=>n.name)))].map((nm) => {
        const a = carmine.notable.find((x) => x.name === nm);
        const b = francesca.notable.find((x) => x.name === nm);
        return (
          <tr>
            <td>{nm}</td>
            <td class="small">{(a || b).where}</td>
            <td class="mono">{a ? a.fit.toFixed(3) : <span class="small">—</span>}</td>
            <td class="mono">{b ? b.fit.toFixed(3) : <span class="small">—</span>}</td>
            <td><span class="fb distant sm">Distant</span></td>
          </tr>
        );
      })}
    </tbody>
  </table></div>

  <h3>Two people with no common ancestor, and one list</h3>
  <p><strong>Carmine and Francesca are husband and wife. This archive documents no ancestor they
  share.</strong> Yet {shared.length} of the names above appear on <em>both</em> lists, and the top
  four are <strong>identical, in the same order</strong>.</p>
  <p><strong>That is the proof, and it needs no genetics to follow.</strong> If the score measured
  descent, two people who are not documented kin could not produce nearly the same ranked list of
  ancestors. What they share is not a family — it is <strong>a region</strong>. The list is a function
  of being Campanian, which both of them are.</p>
  <p>Two further tells point the same way. <strong>Francesca scores closer than Carmine on every single
  entry</strong> — a uniform offset across a whole list is a difference in overall model fit, not a
  relationship; reading it as «Francesca is more related to Beethoven» is exactly the mistake the shape
  of the data warns against. And <strong>the geography does not cohere</strong>: Hungary, Galicia,
  Mycenaean Pylos, Iron Age Iran, the Copper Age Alps, Bonn, revolutionary Paris. <strong>No family
  goes there.</strong></p>

  <h3>Nobody has sequenced a Campanian</h3>
  <p>Read the names again and notice what is <strong>not</strong> there.
  <strong>There is no Italian on either list.</strong> No Neapolitan, no Campanian, nobody from the
  Valle Caudina, from Arienzo or Arpaia or Benevento, nobody Roman, nobody Samnite — and the Samnites
  held these very hills.</p>
  <p>The list is Hungarian and Transylvanian nobility, a Galician bishop, a Mycenaean warrior, two
  Iron Age Iranians, an Alpine iceman, a German composer and a French revolutionary. <strong>That is
  not a statement about this family. It is a statement about which graves have been opened and
  paid for.</strong> Ancient-DNA projects have concentrated on royal tombs and famous individuals; the
  ordinary medieval and early-modern dead of southern Italy have largely not been sequenced.</p>
  <p><strong>A list of notable individuals is a map of published research</strong>, and this family's
  own hills are a blank on it. It is the same rule as the rest of this page in a new dress:
  <strong>an absence in the data is a fact about the data.</strong></p>

  <h2>What the DNA cannot settle here</h2>
  <p>Worth being blunt, because a test that reaches 1790 tells you nothing about the questions this
  archive is actually stuck on. <strong>None of them moves an inch:</strong></p>
  <ul>
    <li>whether generation three's wife was <strong>Andreana Crisci</strong> or
    <strong>Andriana Cioffi</strong> — <a href={u("/crisci")}>Crisci</a>;</li>
    <li>whether <strong>Maria Carfora</strong> was Filomena Annecchino's mother —
    <a href={u("/annecchino")}>Annecchino</a>;</li>
    <li>which <strong>Matteo Falco</strong> is which, or whether <strong>Gioacchino Falco</strong>
    belongs to the founding couple;</li>
    <li>whether the gentry <strong>Rivetti</strong> and the labouring Rivetti are one family —
    <a href={u("/rivetti")}>Rivetti</a>.</li>
  </ul>
  <p><strong>An ethnicity percentage cannot name a parent.</strong> Only a record can, which is why
  the rest of this site looks the way it does.</p>

  <h2>What would actually move it</h2>
  <div class="scroll"><table>
    <thead><tr><th>Test</th><th>What it would reach</th></tr></thead>
    <tbody>
      <tr><td><strong>Y-DNA</strong></td>
        <td><strong>This is the one to do.</strong> Y-DNA passes father to son undiluted — <em>it does
        not halve</em> — so it is the one test the table above does not defeat. It follows precisely
        the spine of this archive: <a href={u("/direct-line")}>Matteo → Pasquale → Vincenzo → Raffaele
        → Carmine Antonio → Raffaele → Carminantonio → Carmine</a>. A haplogroup and its matches are
        <strong>directly testable against the paper line</strong>, and reach back past 1735 where the
        autosomal test cannot.</td></tr>
      <tr><td><strong>mtDNA</strong></td>
        <td>Also undiluted, and it follows the female line this archive spent this year building —
        Morgillo, Maione, Annecchino, Zampiello, <a href={u("/ferrara")}>Ferrara</a>.</td></tr>
      <tr><td><strong>DNA Matches</strong></td>
        <td>More evidentiary than anything above. <strong>A shared-centimorgan match with a documented
        descendant of a named household tests a named claim.</strong> It is the only part of a consumer
        DNA test that can settle a genealogical question, and the part nobody looks at.</td></tr>
      <tr><td><strong>Genetic groups</strong></td>
        <td><strong>Not yet captured here.</strong> These are clusters of <em>living</em> testers and
        record where a family was two or three generations ago — for this family that should mean
        Campania and Brisbane. They are noted as a gap rather than guessed at.</td></tr>
    </tbody>
  </table></div>

  <p class="small" style="margin-top:1.2rem">Figures transcribed in full from the MyHeritage results of
  10 September 2026, ethnicity model v2.5. <strong>Where these numbers disagree with a later version of
  that model, the version is the reason</strong> — and this page will say so rather than quietly
  restate them. Method: <a href={u("/method")}>how this archive decides what to claim</a>.</p>

<style is:global>
  .chip.dna{border-color:var(--terra);color:var(--terra);background:transparent}

  .dnabars{margin:1rem 0 1.2rem;font-family:var(--sans)}
  .dnabars .row{display:grid;grid-template-columns:11rem 1fr 5rem;gap:.7rem;align-items:center;
                padding:.3rem 0;border-bottom:1px solid var(--rule)}
  .dnabars .nm{font-size:13px}
  .dnabars .pair{display:flex;flex-direction:column;gap:.18rem}
  .dnabars .bwrap{display:flex;align-items:center;gap:.4rem}
  .dnabars .bar{height:.5rem;border-radius:2px;min-width:2px}
  .dnabars .v{white-space:nowrap}
  .dnabars .bar.c{background:var(--accent)}
  .dnabars .bar.f{background:var(--terra)}
  .dnabars .v{font-family:var(--mono);font-size:11px;color:var(--ink-2)}
  .dnabars .dv{font-family:var(--mono);font-size:11px;color:var(--ink-3);text-align:right}
  .dnabars .key{margin:.6rem 0 0;font-size:11px;color:var(--ink-2)}
  .dnabars .sw{display:inline-block;width:.7rem;height:.55rem;border-radius:2px;vertical-align:middle}
  .dnabars .sw.c{background:var(--accent)} .dnabars .sw.f{background:var(--terra)}
  @media(max-width:640px){.dnabars .row{grid-template-columns:8rem 1fr 3.4rem}}

  table.hz tr.self td{background:var(--accent-wash)}
  table.hz tr.floor td{opacity:.6}
  table.hz tr.floor td:first-child{border-left:3px solid var(--accent)}

  .fitscale{display:flex;flex-wrap:wrap;gap:.4rem;align-items:center;margin:.8rem 0 1rem}
  .fb{font-family:var(--sans);font-size:11px;padding:.2rem .5rem;border-radius:3px;
      border:1px solid var(--rule-strong);color:var(--ink-2)}
  .fb.veryclose{border-color:var(--terra);color:var(--terra)}
  .fb.close{border-color:var(--terra);color:var(--terra);opacity:.8}
  .fb.moderate{border-color:var(--ochre);color:var(--ochre)}
  .fb.distant{border-color:var(--accent);color:var(--accent);background:var(--accent-wash);font-weight:600}
  .fb.sm{font-size:10px;padding:.1rem .35rem}
  .fitscale .note{font-family:var(--sans);font-size:11px;color:var(--ink-3);font-style:italic}
</style>
</Base>
