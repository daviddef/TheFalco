---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import places from "../data/places.json";
import line from "../data/line.json";
import { people } from "../lib/people.js";
const livingGen = new Set(people.filter((p) => p.living && p.gen).map((p) => p.gen));
const legs = [
  { from: "Arienzo", to: "Arienzo", km: 0, when: "c. 1735 – 1901", gens: "1 to 7",
    what: "Seven generations do not move at all. Every one of them is born, married and buried within the same parish — and most of them on or beside one street, strada Camellara." },
  { from: "Arienzo", to: "Arpaia", km: 4, when: "1913", gens: "7",
    what: "The first move in two hundred years, and it crosses a provincial border — Caserta to Benevento — without leaving walking distance. Gerardo Falco is born here in 1913." },
  { from: "Arpaia", to: "Forchia", km: 3, when: "1930", gens: "8",
    what: "Carmine Falco is born at Forchia, a town named for the Forche Caudine — the Caudine Forks, where a Roman army was made to pass under the yoke in 321 BC." },
  { from: "Forchia", to: "Benevento", km: 20, when: "1955", gens: "8 to 9",
    what: "Carmine Falco marries Francesca Zampiello; Giuseppina is born the same year. The capital of the Lombard duchy that gave southern Italy the personal name Falco." },
  { from: "Benevento", to: "Brisbane", km: 15800, when: "20th century", gens: "8 and 9",
    what: "And then, in one lifetime, sixteen thousand kilometres. The family that had not left one parish in seven generations crosses the world." },
];
const walk = legs.slice(0, 4).reduce((a, l) => a + l.km, 0);
---
<Base title="Journeys"
      eyebrow="Seven generations in one parish, then sixteen thousand kilometres"
      dek="The whole geography of this family in five moves — four of which you could walk in a day, and one which you could not.">

  <div class="card" style="margin-bottom:1.2rem">
    <p><strong>The shape of this family's movement is the most striking thing about it.</strong> From
    about 1735 to 1901 — <strong>seven generations</strong> — nobody leaves Arienzo. Then, inside a
    single lifetime, the line moves to Arpaia, to Forchia, to Benevento and to Australia.</p>
    <p style="margin-top:.6rem"><strong>The first four moves total {walk} kilometres.</strong> The
    fifth is <strong>15,800</strong>.</p>
  </div>

  <figure class="jrny">
    {legs.map((l, i) => (
      <div class={"leg" + (l.km > 1000 ? " far" : "")}>
        <div class="dot"><i></i></div>
        <div class="body">
          <h3>{l.from === l.to ? l.from : <>{l.from} <span class="dim">→</span> {l.to}</>}
            <span class="km mono">{l.km === 0 ? "stays put" : l.km.toLocaleString() + " km"}</span></h3>
          <p class="small mono dim">{l.when} · generation{l.gens.includes("to") ? "s" : ""} {l.gens}</p>
          <p>{l.what}</p>
        </div>
      </div>
    ))}
  </figure>

  <div class="card" style="margin:1.2rem 0;border-left:3px solid var(--accent)">
    <p><strong>Why seven generations stayed.</strong> They were <em>coloni</em> and
    <em>contadini</em> — men who worked another man's land. <strong>You cannot take a tenancy with
    you.</strong> The registers record the same twenty surnames on the same nineteen streets for two
    hundred years, and <a href={u("/dna")}>the DNA measures the same closed valley from the other
    end</a>: two people born eight kilometres apart who are, at the test's resolution,
    indistinguishable.</p>
  </div>

  <h2>The places themselves</h2>
  <div class="scroll"><table>
    <thead><tr><th>Place</th><th>Province</th><th>When</th><th>Why it is in this story</th></tr></thead>
    <tbody>
      {places.map((p) => (
        <tr><td><strong>{p.name}</strong></td><td class="small">{p.prov}</td>
          <td class="small mono" style="white-space:nowrap">{p.from} – {p.to}</td>
          <td class="small">{p.what}</td></tr>
      ))}
    </tbody>
  </table></div>

  <p class="small" style="margin-top:1.6rem">
    <a href={u("/atlas")}>The Atlas</a> · <a href={u("/emigration")}>Leaving</a> ·
    <a href={u("/valle-caudina")}>The Valle Caudina</a> · <a href={u("/australia")}>Australia</a></p>

<style is:global>
  .jrny{margin:1.4rem 0}
  .jrny .leg{display:grid;grid-template-columns:1.6rem 1fr;gap:.9rem;padding:0 0 1.1rem}
  .jrny .dot{position:relative}
  .jrny .dot i{display:block;width:.7rem;height:.7rem;border-radius:50%;background:var(--ink-3);margin-top:.45rem}
  .jrny .dot::after{content:"";position:absolute;left:.32rem;top:1.2rem;bottom:-1.1rem;width:1px;background:var(--rule)}
  .jrny .leg:last-child .dot::after{display:none}
  .jrny .leg.far .dot i{background:var(--accent);width:.9rem;height:.9rem;margin-left:-.1rem}
  .jrny h3{margin:.2rem 0 .1rem;display:flex;gap:.7rem;align-items:baseline;flex-wrap:wrap}
  .jrny .km{font-size:11px;color:var(--ink-3)}
  .jrny .leg.far .km{color:var(--accent);font-weight:600}
  .jrny p{margin:.3rem 0;max-width:76ch}
</style>
</Base>
