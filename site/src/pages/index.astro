---
import Base from "../layouts/Base.astro";
import WaysIn from "@daviddef/archive-kit/components/WaysIn.astro";
import Numbers from "@daviddef/archive-kit/components/Numbers.astro";
import PlaceSpark from "@daviddef/archive-kit/components/PlaceSpark.astro";
import MarriageChart from "@daviddef/archive-kit/components/MarriageChart.astro";
import Spine from "@daviddef/archive-kit/components/Spine.astro";
import Descent from "@daviddef/archive-kit/components/Descent.astro";
import line from "../data/line.json";
import { chartGroups } from "../lib/marriedin.js";
import atlas from "../../public/atlas-data.json";
import P from "../components/P.astro";
import { u } from "../lib/url.js";
import Tributaries from "../components/Tributaries.astro";
import Strands from "../components/Strands.astro";
import households from "../data/households.json";
import register from "../data/register.json";
import line from "../data/line.json";
import corrections from "../data/corrections.json";
import atlas from "../../public/atlas-data.json";
import { people } from "../lib/people.js";

const entries = households.reduce((a, h) => a + h.members.length, 0);
const more = [
  ["/rule", "Under whose rule", "Spanish viceroys, Austrians, Bourbons, the French, then Italy — and why a Napoleonic filing rule is the reason this archive can go back past 1809 at all."],
  ["/searched", "What has been read", "Eleven annual registers read page by page, including the three that held no Falco at all — because a null is a result, and it stops the next person repeating the search."],
  ["/families", "The families they married", "Crisci, Morgillo, Rivetti, di Guida, Arricale, Maione, Annecchino, Zampiello — ten families in their own right, three of which married in more than once."],
  ["/arienzo", "Arienzo", "The home parish, and the Collegiate Church of Sant'Andrea, which holds baptisms from 1672."],
  ["/liguori", "The bishop next door", "From 1762 to 1775 the bishop of Sant'Agata de' Goti kept his second seat beside this church, and he was Alfonso Maria de' Liguori."],
  ["/valle-caudina", "The Valle Caudina", "Three villages four kilometres apart in two provinces, and the marriage pool that moved the family north."],
  ["/zampiello", "The Zampiello of Arpaia", "A surname with about 123 bearers in the world, four sisters who reached Queensland, and a war decoration found in the family's own papers."],
  ["/australia", "Brisbane", "Two brothers who married two sisters, the ship, and four Falco graves at Nudgee."],
  ["/name", "The name", "Falco was coined independently many times over. What that means for anyone searching it."],
  ["/places", "Places", "The six places that carry this family, and the four kilometres that crossed a border."],
];

/* «and why no links for the wives?» — 22 September. Because line.json
   carries her as a name and nothing else, while the husband arrives with
   an identifier. Five of the nine wives do have a page in this archive and
   were being drawn as plain text beside a linked husband.

   MATCHED ONLY WHERE EXACTLY ONE PERSON BEARS THE NAME, and counted at
   build time rather than written down, so the day a second Francesca
   Zampiello enters people.json the link disappears instead of quietly
   pointing at the wrong woman. This archive has two Raffaele Falcos and
   two Carmine Antonios on the spine alone; a name is not an identity here.
   The husband's own link is safe for the opposite reason — `slugFor`
   matches on GENERATION AND NAME together. */
const SPOUSE_SLUG = (() => {
  /* people.json WRITES A MARRIED WOMAN "Maiden (Married)" — "Giovanna
     Arricole (Falco)", "Constanza Maione (Falco)" — while line.json writes
     her maiden name alone, so plain equality missed every wife who took
     the surname.

     TWO MAPS, TRIED IN ORDER, NOT ONE MAP WITH BOTH KEYS IN IT. The first
     attempt keyed every person under their full name and their name minus
     the parenthetical, in a single map — which let "Francesca Crisci
     (Falco)" collide with a different woman actually named Francesca
     Crisci and poison a key that had been matching correctly. Five links
     became one. An exact name is better evidence than a stripped one, so
     it is asked first and only falls through when it finds nothing. */
  const bare = (n) => String(n || "").replace(/\s*\([^)]*\)\s*$/, "").trim();
  const exact = new Map(), loose = new Map();
  const put = (m, k, slug) => { if (k) m.set(k, m.has(k) ? null : slug); };
  for (const p of people) {
    put(exact, String(p.name || "").trim(), p.slug);
    const b = bare(p.name);
    if (b && b !== String(p.name || "").trim()) put(loose, b, p.slug);
  }
  /* A KEY WITH TWO BEARERS IS POISONED, NEVER PICKED BETWEEN. Three people
     here are called Andreana Crisci — generation three's wife, a daughter
     named after her, and an unrelated woman — so generation three keeps a
     name and no link, which is the right answer. This archive has two
     Raffaele Falcos and two Carmine Antonios on the spine alone; a link to
     the wrong woman is worse than no link at all. */
  return (name) => {
    const n = String(name || "").trim();
    // "Chiara Rivetti / Rivotti" offers two spellings; try each.
    const keys = [n, ...n.split("/").map((x) => x.trim())].filter(Boolean);
    for (const k of keys) { const s = exact.get(k); if (s) return s; }
    for (const k of keys) { const s = loose.get(k); if (s) return s; }
    return null;
  };
})();

/* THE DESCENT. Replaces the compact ladder with the kit's Descent row:
   the couple as two equal columns, the children under them, the brothers
   and sisters under whichever of the two they belong to, everything shut
   until opened.

   THIS ARCHIVE NEEDS NO DERIVATION. people.json records children and
   siblings per person, and marks the child who carried the line with
   `via: "line"` — so the carrier is the archive's own answer, not one
   worked out here. The people are reached by the identifiers already
   trusted elsewhere on this page: `slugFor` matches GENERATION AND NAME
   together (which is what keeps the two Raffaele Falcos apart), and
   SPOUSE_SLUG matches her name only where exactly one person bears it.

   HER SIBLINGS COME FROM HER OWN RECORD, which is the point of the
   column: where this archive has read her family, it shows it beside his
   rather than under him. */
/* `slugFor` lives in direct-line.astro, not here — I assumed it was shared
   and the build said so. It is the same two lines, and it is the reason the
   two Raffaele Falcos of generations four and six keep separate pages:
   GENERATION AND NAME together, never a name alone. */
const cleanNm = (x) => String(x || "").replace(/\s*\(.*?\)\s*/g, " ").replace(/\s+/g, " ").trim();
const slugFor = (g) => {
  const q = people.find((x) => x.gen === g.gen && cleanNm(x.name) === cleanNm(g.name));
  return q ? q.slug : null;
};
const P_BY_SLUG = new Map(people.map((q) => [q.slug, q]));
const lifeOf = (q) => [q && q.b, q && q.d].filter(Boolean).join(" \u2013 ");
const kin = (slug, band) => {
  const rec = slug ? P_BY_SLUG.get(slug) : null;
  return ((rec && rec[band]) || []).map((c) => {
    const full = P_BY_SLUG.get(c.slug);
    return {
      name: c.name,
      href: c.slug && full && !full.living ? `/people/${c.slug}/` : null,
      dates: full && !full.living ? lifeOf(full) : "",
      line: band === "children" && (c.via === "line" || (c.vias || []).includes("line")),
    };
  });
};
/* The prose in `born` is right in the full spine and long in a column:
   "about 1747 — «annorum 55 circiter» at his death". Cut at the dash that
   introduces the gloss, as the spine pills do. */
const clip = (v) => String(v ?? "").split(/\s+[\u2013\u2014-]\s+/)[0].trim();

const descentRows = line.map((g) => {
  const mine = slugFor(g);
  const hers = SPOUSE_SLUG(g.spouse);
  return {
    gen: g.gen,
    era: [clip(g.born), clip(g.died)].filter(Boolean).join(" \u2192 ") || undefined,
    name: g.name,
    href: mine ? `/people/${mine}/` : "",
    born: clip(g.born),
    died: clip(g.died),
    trade: g.trade || "",
    place: g.bornPlace || g.diedPlace || "",
    married: g.married || "",
    confidence: g.confidence || "",
    living: !!g.living,
    weak: g.gen === 1,
    weakNote: "The line stops here: no record names this man's father.",
    spouse: g.spouse || "",
    spouseHref: hers ? `/people/${hers}/` : null,
    spouseBorn: clip(g.spouseBorn || ""),
    spouseAlt: hers ? "" : "no page of her own in this archive yet",
    children: kin(mine, "children"),
    hisSiblings: kin(mine, "siblings"),
    herSiblings: kin(hers, "siblings"),
    hisLabel: String(g.name).split(" ")[0] + "\u2019s",
    herLabel: g.spouse ? String(g.spouse).split(" ")[0] + "\u2019s" : "Hers",
    note: g.note || "",
  };
});

const withSpouse = (g) => ({
  ...g,
  spouseHref: SPOUSE_SLUG(g.spouse) ? `/people/${SPOUSE_SLUG(g.spouse)}/` : null,
});

---
<Base title="The Falco Archive" bare={true}>
  <figure class="fhero">
    <img src={u("/hero/arienzo-piazza.jpg")} alt="The piazza and collegiate church of a hill town in Campania" />
    <figcaption class="cap">
      <div class="kick">A family history, kept honestly</div>
      <h1>Nine generations, on one street in Campania.</h1>
      <p class="sub">Arienzo · Arpaia · Forchia · Benevento · Brisbane — written into the parish books
      of Sant'Andrea from 1767, and into the civil registers of four regimes after that.</p>
    </figcaption>
  </figure>

  <section class="blk">
    <p class="lede">This is an archive of <strong>the Falco of Arienzo</strong> — a parish, a street and
    the families on it — and of the one branch of them that reached Brisbane. It is not a pedigree.
    Of the {people.length} people named here, {people.length - 8} are not in the direct line.</p>
    <blockquote>
      <em>Falco</em> is the Latin for falcon, and it became a surname twice over: as a Lombard personal
      name handed down as a patronymic, and as a nickname for the quick, the sharp-eyed, or the
      falconer. It was coined independently, many times, in many places.
      <strong>There is no single founding Falco family.</strong> The work here is to establish which
      Falco are actually connected, and to say plainly where the evidence stops.
    </blockquote>
  </section>

  
  <p class="lede" style="margin-top:14px">
    It is a public archive with one rule: <b>a living person is named and nothing more</b> — no
    dates, no places, nothing that is theirs to give rather than this archive's. And a second rule,
    which is harder: <b>every claim says how well it is known</b>.
    <span class="chip doc" style="padding:2px 8px;font-size:10px">Documented</span>
    <span class="chip inf" style="padding:2px 8px;font-size:10px">Inferred</span>
    <span class="chip lore" style="padding:2px 8px;font-size:10px">Family lore</span>
  </p>

  <WaysIn doors={[
    { href: u("/direct-line/"), name: "The spine, act by act", blurb: "Nine generations in one valley, 1767 to now, each joined to the one above it by a record that names a father — except the first, where the line stops.", cta: "Start at Arienzo →" },
    { href: u("/processetti/"), name: "The marriage dossiers", blurb: "The processetti: the paperwork a couple had to assemble before they could marry, naming parents, grandparents and the dead. The richest single source this archive has.", cta: "Open the dossiers →" },
    { href: u("/atlas/"), name: "Where it happened", blurb: "Six parishes and a crossing to Brisbane — and behind the markers, the register volumes themselves, opened at page one.", cta: "Open the atlas →" },
  ]} />

<section class="blk">
    <div class="lab">Several Falco, one town</div>
    <h2 style="margin-top:.4rem">Where each of them came from, and what joins them</h2>
    <p class="dek" style="margin:.7rem 0 1.4rem">A shared surname in one small town is suggestive and
    nothing more. Two Falco households on the same street may be brothers, cousins, or unrelated men
    who happen to carry a common Campanian name. This archive joins two of them only when a record says
    so — and draws the rest apart, even where joining them would make the better story.</p>
    <Tributaries />

    <h3 style="margin:2rem 0 .3rem">And the same question drawn the other way</h3>
    <p class="dek" style="margin:0 0 1.2rem">The figure above is <strong>one family moving</strong>.
    This one is <strong>five strands of one surname</strong> — a spine of places in date order, a fan
    of where each ends up, and a line in small capitals saying how well it is documented.
    <strong>A dashed strand goes nowhere this archive can follow, or is not this family.</strong>
    Only the top band is this line.</p>
    <Strands />

    <p style="margin-top:1.2rem"><a href={u("/lines/")}>The lines, in full →</a></p>
  </section>

  <section class="blk">
    <div class="lab">The document at the centre of it</div>
    <h2 style="margin-top:.4rem">1 October 1834, five in the morning</h2>
    <div class="hero-plate" style="margin-top:1.2rem">
      <img src={u("/plates/pasquale-falco-death-1834.jpg")} alt="Arienzo civil death register 1834, act 69 — the death of Pasquale Falco" />
      <div>
        <p>For as long as this family has had a pedigree, the head of it was a guess. Then two
        neighbours from <strong>strada Camellara</strong> walked to the town hall at Arienzo and
        reported the death of the man next door.</p>
        <blockquote style="margin:.9rem 0">…è morto nella sua propria casa <P n="Pasquale Falco" bold={true} />,
        d'anni settantaquattro, <em>marito di <P n="Chiara Rivetti" bold={true} /></em>, di professione
        contadino, <em>figlio di <strong>Matteo Falco, defunto</strong>… e di
        <strong>Francesca Crisci, defunta</strong></em>.</blockquote>
        <p>One act names his wife, both his parents, his trade and his street — and confirms, from the
        civil register, what a parish baptism of 1767 had said sixty-seven years earlier.
        <a href={u("/antenati/")}>How it was found →</a></p>
      </div>
    </div>
  </section>

  <section class="blk">
    <h2>Elsewhere in the archive</h2>
    <div class="grid two" style="margin-top:1rem">
      {more.map(([href, t, d]) => (
        <a class="cardlink" href={u(href)}>
          <div class="nm">{t}</div>
          <p class="small" style="margin-top:.4rem">{d}</p>
        </a>
      ))}
    </div>
  </section>

  
<section class="blk">
  <section class="feat">
    <h2 style="margin-top:6px">Where this family can actually be put</h2>
    <p class="dek" style="margin-top:10px">Four kilometres of the Valle Caudina, and then Brisbane.
    <strong>Every dot is a place this archive can put a named person in.</strong> The coast and the
    borders under them are real — Natural Earth, clipped to this frame — so a dot can be read as
    somewhere rather than as a position in an empty box. This archive has had a map on
    <a href={u("/atlas/")}>its atlas</a> and none on its front page until now.</p>
    <PlaceSpark places={atlas.places} href={u("/atlas/")}
                label={`${atlas.places.length} places — the towns this family can be put in`} />
  </section>
</section>


<section class="blk">
  <section class="blk">
    <h2>The line, nine generations</h2>
    <p class="dek">From Matteo, born about 1747 at Arienzo, to the generation that left for
    Queensland. Seven of the nine never moved out of one town.</p>
    {/* Compact mode links each row to its own generation anchor on the full spine, NOT to a
        person page. This line holds two Raffaele Falco — generations four and six, grandfather
        and grandson — who slug identically, and a Carmine Antonio at five and seven. A name is
        not an identity here; a position in the line is. */}
    <Descent rows={descentRows} u={u} archiveKey="falco" />
    <p class="cap" style="margin-top:14px"><a href={u("/direct-line/")}>The full spine, with the
    evidence under each generation →</a></p>
  </section>

  <h2>The families who married in</h2>
  <p class="dek">Seventy-six surnames joined this line, and each is here for one reason — that a
  person married a person. They are grouped by <strong>how they reach this family</strong>,
  computed over people and never over spelling.
  <a href={u("/marriages/")}>The marriages, in full →</a></p>
  <MarriageChart groups={chartGroups} subject="Falco" unit="how many of their people reach this line" />
</section>

<section class="blk">
    <h2>What this archive has established</h2>
    <div class="grid two" style="margin-top:1rem">
      <div class="card">
        <h3>A head to the line</h3>
        <p><P n="Matteo Falco" bold={true} /> and <P n="Francesca Crisci" bold={true} />, whose children were
        baptised at Arienzo from 1767 — replacing an ancestor who was never there. Two of those
        children's death acts name them again — Rosa's in 1830, Pasquale's in 1834.
        <a href={u("/direct-line/")}>The spine →</a></p>
      </div>
      <div class="card">
        <h3>An address</h3>
        <p><strong>Strada Camellara.</strong> Six Falco householders on one short street, all
        <em>contadini</em> or <em>coloni</em>, and the neighbours who reported each death lived a few doors along.
        <a href={u("/lines/")}>The street →</a></p>
      </div>
      <div class="card">
        <h3>{people.length} people, not eight</h3>
        <p>{households.length} households and {entries} register entries, most of them belonging to
        somebody who never continued the line. <a href={u("/wider-family/")}>The wider family →</a></p>
      </div>
      <div class="card">
        <h3>One kinship, proved</h3>
        <p>In 1831 <P n="Vincenzo Falco" bold={true} /> declared a neighbour's death as <em>parente</em> — a
        kinsman — joining the line to a second Camellara household. Three others remain unjoined.
        <a href={u("/lines/")}>What joins them →</a></p>
      </div>
    </div>
  </section>

  <Numbers rows={[
    [register.length, "acts read in the parish registers of Arienzo and its neighbours", u("/register/")],
    [people.length, "people published, each on a page of their own", u("/people/")],
    [line.length, "generations of one descent, 1767 to now, every link on a record", u("/tree/")],
    [atlas.places.reduce((a, p) => a + (p.nfilms || 0), 0), "register volumes reachable from the place they were kept in", u("/atlas/")],
    [corrections.length, "claims this archive has withdrawn or corrected", u("/corrections/")],
    [households.length, "households reconstructed from the acts", u("/households/")],
  ]} />

  <section class="blk" style="border-bottom:0">
    <h2>What is still missing</h2>
    <p class="dek">Eleven questions this archive cannot answer, and five doors that need a person
    rather than a machine — the unread Brisbane immigration files, the restricted Caserta scans, two
    volumes at Benevento that were never digitised, the marriage supplements, and the DNA matches.
    All of it, with the searches that have already failed, is set out at
    <a href={u("/open-questions/")}>Open questions</a>.</p>
    <p class="small" style="margin-top:1rem">Nothing here is taken on trust because it appears in a
    family tree. Where a record has been seen, it is cited; where it has not, the claim is marked.
    See <a href={u("/method/")}>Method</a>.</p>
  </section>

</Base>
