---
import Base from "../layouts/Base.astro";
import Families from "@daviddef/archive-kit/components/Families.astro";
import { u, plainHref } from "../lib/url.js";
import register from "../data/register.json";
import households from "../data/households.json";
import line from "../data/line.json";
import { findPerson } from "../lib/people.js";
import { stats } from "../lib/familystats.js";

const rows = (sn) => register.filter((r) => r.surname === sn).length;
/* 22 September 2026. «Eleven families» was typed in the eyebrow and the
   twelfth — CARFORA, the fifth-largest surname in the archive — was added the
   same day the array below became data. A count in prose beside a count in
   data is a count that will disagree with itself. */
const WORD = ["no","One","Two","Three","Four","Five","Six","Seven","Eight","Nine","Ten",
              "Eleven","Twelve","Thirteen","Fourteen","Fifteen","Sixteen"];
const P = (name, house) => {
  const p = findPerson(name, house);
  return p ? u("/people/" + p.slug) : null;
};
/* UNBASED, on purpose. The kit component prefixes the site base onto hrefs
   inside the HTML it is handed — which is right, because `body` below holds
   hand-written links like /open-questions/ that need it. Handing it a path
   P() has ALREADY based produced /TheFalco/TheFalco/people/francesca-crisci,
   thirteen of them, caught by the link checker. One or the other bases a
   link, never both. */
const Praw = (name, house) => {
  const q = findPerson(name, house);
  return q ? "/people/" + q.slug : null;
};

/* 22 September 2026. The eleven families were a JavaScript array in this
   file — the fourth list this week found living somewhere only a template
   could reach, after Blazevic's photograph jobs, this archive's own five
   strands and Luwinski's ten open questions. They are
   src/data/families.json now, extracted by RUNNING the array rather than
   retyping it.

   The card is the kit's. What this archive puts behind the claim is the
   MARRIAGES, generation by generation — which Falco married which — because
   that is what its joins actually rest on. D'Arcy names the people instead;
   Blazevic can name nobody and gives counts and spellings. The component
   requires none of the three.

   The column headings stay this archive's own words. "Generation / Falco /
   married" is a sentence about this family, not a schema. */
import fams from "../data/families.json";

const slugify = (x) =>
  String(x).toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");

const handWritten = fams.families.filter((f) => !f.derived);
const derived = fams.families.filter((f) => f.derived);

const groups = [{
  rows: handWritten.map((f) => ({
    label: f.name,
    count: rows(f.sn),
    countLabel: "records",
    gloss: `<strong>${f.times}</strong>`,
    facts: f.where ? [["Where", f.where]] : [],
    marriages: {
      head: ["Generation", "Falco", "married"],
      rows: f.into.map(([g, a, b]) => [
        g === "\u2014" ? "collateral" : "gen " + g,
        Praw(a) ? `<a href="${Praw(a)}">${a}</a>` : a,
        Praw(b) ? `<a href="${Praw(b)}">${b}</a>` : b,
      ]),
    },
    note: plainHref(f.body + (f.note ? ` ${f.note}` : "")),
    /* Each family now has a page of its own listing every person of the
       name, drawn with the same Descent row as the front page. */
    href: `/families/${slugify(f.sn)}/`,
    hrefLabel: `Everyone of the name`,
  })),
}];

const otherGroups = [{
  /* 17 October 2026. Families the archive has researched but no marriage into the direct
     line carried onto the page above. They come from the same people.json, through the
     same page template, and say only what can be counted: no prose of the research
     owner's is added or restated. */
  rows: derived.map((f) => {
    const st = stats(f);
    return {
      label: f.name,
      count: st.ours.length,
      countLabel: st.ours.length === 1 ? "person" : "people",
      gloss: `<strong>${st.yFrom ? `Dated ${st.yFrom} to ${st.yTo}` : "No dated entries"}</strong>` +
        (st.ours.length ? ` &mdash; ${st.nRecord} read from records, ${st.nTree} from the family tree only` +
          (st.nLiving ? `, ${st.nLiving} living` : "") : ""),
      facts: st.placesSorted.length
        ? [["Where", st.placesSorted.slice(0, 4).map(([t, n]) => `${t} (${n})`).join(", ")]]
        : [],
      href: `/families/${slugify(f.sn)}/`,
      hrefLabel: "Everyone of the name",
    };
  }),
}];

---
<Base title="The families"
      eyebrow={`${WORD[handWritten.length] || handWritten.length} families, not one surname`}
      dek="A family history that follows only one surname is half a history. These are the families the Falco married — what is known of each in its own right, how often they married in, and where the evidence for them stops.">

  <div class="card" style="border-left:3px solid var(--accent)">
    <p>Every generation of this line is half somebody else's family. Where a Falco married, the wife's
    people are a family with their own street, their own trades and their own gaps — and in three
    cases they married in more than once, so the two families are woven rather than joined.</p>
    <p class="small" style="margin-top:.6rem">Counts below are rows in
    <a href={u("/register/")}>the register</a>, which includes surname-index hits — a count is a measure
    of what has been gathered, not of proven kinship.</p>
  </div>

  <section class="blk">
    <Families groups={groups} u={u} />
  </section>

  <section class="blk">
    <h2>Families married by the collaterals</h2>
    <p class="dek">Beyond the ten above, the Falco households this archive has reconstructed also
    married <strong>Loffreda</strong> (Francesco Falco × Antonia Loffreda), <strong>Mara</strong>
    (Tommaso Falco × Marta Mara) and <strong>Iuliuccio</strong> (Francesco Falco × Mariangela
     Iuliuccio) — and, in 1832, <strong>a Falco married a Falco</strong>: Francesco Falco and Raffaela
    Falco of strada Camellara, which in a town this size ordinarily means cousins and a dispensation.</p>
    <p class="small" style="margin-top:.8rem">Every person named on this page has a page of their own
    at <a href={u("/people/")}>The people</a>, or an entry with its source at
    <a href={u("/register/")}>The register</a>.</p>
  </section>

  <section class="blk" style="border-bottom:0">
    <h2>Other families this archive has researched</h2>
    <p class="dek">These are not among the twelve above. A family is here because the archive names
    eight or more people of the name, or because its own work list or open questions are about it:
    {derived.reduce((a, f) => a + stats(f).ours.length, 0)} people in all. Each page is built from the
    register alone &mdash; a count, the years, the places, the households and the archive&rsquo;s own
    titles &mdash; and is not a finding.</p>
    <Families groups={otherGroups} u={u} />
  </section>
</Base>
