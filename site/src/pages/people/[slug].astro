---
import Base from "../../layouts/Base.astro";
import { u } from "../../lib/url.js";
import { md } from "../../lib/md.js";
import { people, bySlug } from "../../lib/people.js";
import households from "../../data/households.json";
import plates from "../../data/plates.json";
import PersonTree from "../../components/PersonTree.astro";
import HouseholdTree from "../../components/HouseholdTree.astro";

export function getStaticPaths() {
  return people.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const clean = (s) => String(s||"").replace(/\s*\(.*?\)\s*/g," ").replace(/\s+/g," ").trim();

/* line.json's notes are written in markdown, and the dek is plain text — the
   asterisks were being printed literally under the name. Take the first
   sentence and drop the emphasis marks. */
const plain = (s) => String(s || "").replace(/\*\*(.*?)\*\*/g, "$1").replace(/[*_`]/g, "");
const firstSentence = (s) => {
  const t = plain(s).trim();
  const m = t.match(/^[\s\S]*?[.!?](?=\s|$)/);
  return (m ? m[0] : t).trim();
};

const sameName = people.filter((q) => q.slug !== p.slug && clean(q.name) === clean(p.name));
const ownHouse = p.household
  ? households.find((h) => h.name.split(/\s*&\s*/).some((n) => clean(n) === clean(p.name)))
  : null;

/* THE PICTURES THAT BELONG TO THIS PERSON. A plate names the people it shows in
   its «who» list (person slugs); the page draws them. No photograph is shown for
   a living person whatever the data says. */
const mine = p.living ? [] : plates
  .filter((x) => (x.who || []).includes(p.slug))
  .sort((a, b) => (b.k === "photo") - (a.k === "photo"));   // pictures of the person first, papers after
const plateId = (x) => String(x.f).replace(/\.jpg$/, "");

const kin = ["parents","spouses","children","siblings"];
const edges = kin.flatMap((b) => p[b] || []);
const fromRegister = edges.filter((e) => e.via !== "tree").length;
const fromTree     = edges.filter((e) => e.via === "tree").length;

/* What to put under the name. A living person gets their place in the family and
   their town and country, and nothing else — no dates, no records. */
const dek = p.living
  ? "A living relative. This archive shows their name, their place in the family and their town and country, and nothing more."
  : p.gen
  ? firstSentence(p.line.note)
  : p.household
  ? `Recorded in the household of ${p.household}.`
  : edges.length
  ? "Known from the family tree. No register act has been read for this person yet."
  : "Named in this archive, with no relationship recorded for them yet.";
---
<Base title={p.name}
      eyebrow={p.gen ? `Generation ${p.gen} of the direct line` : (p.household || p.surname)}
      dek={dek}
      noindex={!!p.living}>

  <PersonTree person={p} />

  {mine.length ? (
    <section class="card pp" aria-label="Photographs and papers">
      <h2 class="ct">Photographs and papers</h2>
      <div class="pp-row">
        {mine.map((x) => (
          <figure class="pp-fig">
            <a href={u("/documents/") + "#" + plateId(x)}><img src={u("/plates/" + x.f)} alt={x.t} loading="lazy" /></a>
            <figcaption>
              <strong>{x.t}</strong>
              {x.when ? <span class="small mono"> · {x.when}</span> : null}
              <span class="small"> — <a href={u("/documents/") + "#" + plateId(x)}>caption and source →</a></span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  ) : null}

  <div class="grid two">
    <div class="card">
      <h2 class="ct">What the registers say</h2>
      {p.events && p.events.length ? (
        <ul style="margin:.4rem 0">
          {p.events.map((e) => (
            <li style="margin:.6rem 0">
              <strong>{e.event}</strong>{e.date && e.date !== "—" ? <span> — {e.date}</span> : null}
              {e.place ? <span>, {e.place}</span> : null}
              {e.evidence ? <div class="small" style="margin-top:.25rem">“<Fragment set:html={md(e.evidence, u)} />”</div> : null}
              {e.ark ? <div class="small mono">{e.ark}</div> : null}
            </li>
          ))}
        </ul>
      ) : p.living ? (
        <p class="small"><strong>A living person shows a name, their relationships and their town and
        country, and nothing more.</strong> No date, no record, no photograph and no source is
        published for them; their page is not offered to search engines. That is the rule, not a
        gap. See <a href={u("/method/")}>Method</a>.</p>
      ) : (
        <p class="small">No act has been read for this person. What is known of them comes from the
        family tree, and is <strong>unverified</strong> —
        <a href={u("/register/") + "?q=" + encodeURIComponent(clean(p.name))}>search the register for the name →</a></p>
      )}
      {p.living && p.place ? (
        <p class="small"><strong>town and country</strong> {p.place}</p>
      ) : null}
      {!p.living && (p.bp || p.dp) ? (
        <p class="small">{p.bp ? <span><strong>born</strong> {p.bp}</span> : null}
        {p.bp && p.dp ? " · " : null}
        {p.dp ? <span><strong>died</strong> {p.dp}</span> : null}</p>
      ) : null}
    </div>

    <div class="card">
      <h2 class="ct">Where this comes from</h2>
      <p class="small">
        {fromRegister ? <span><strong>{fromRegister}</strong> of the {edges.length} relationships
          shown above {fromRegister === 1 ? "is" : "are"} written in a record this archive has read.
        </span> : null}
        {fromTree ? <span> <strong>{fromTree}</strong> {fromTree === 1 ? "comes" : "come"} from the
          family tree and {fromTree === 1 ? "is" : "are"} <strong>unverified</strong>.</span> : null}
        {!edges.length ? <span>No relationship is recorded for this person.</span> : null}
      </p>
      {p.mergedOn ? (
        <p class="small"><strong>This page joins two records</strong> — one from the registers, one
        from the family tree — matched on <strong>{p.mergedOn}</strong>.
        {p.mergedOn === "name alone"
          ? " No date confirms the join. It is the only person of this name on either side, which is why it was made, and it is said here rather than hidden."
          : " Their years agree, which is what allowed the join."}</p>
      ) : null}
      {p.household ? (
        <p class="small"><strong>Household:</strong> <a href={u("/households/")}>{p.household}</a></p>
      ) : null}
      {p.gen ? <p class="small"><a href={u("/direct-line/") + "#gen-" + p.gen}>See this generation on the spine →</a></p> : null}
      {p.living ? (
        <p class="small"><strong>No register link is offered for a living person.</strong> The
        registers do hold people of this name — they are <em>other people</em>, dead long ago, and
        pointing at them from here would invite the reader to read a stranger's record as this
        person's.</p>
      ) : (
        <p class="small"><a href={u("/register/") + "?q=" + encodeURIComponent(clean(p.name))}>Every record naming {clean(p.name)} →</a></p>
      )}
    </div>
  </div>

  {ownHouse ? <HouseholdTree household={ownHouse} eyebrow="The household as the registers built it" /> : null}

  {sameName.length ? (
    <>
      <h2>Others of the same name</h2>
      <p class="small">This parish repeats its names relentlessly — there are three Maria Falco and
      four Pasquale. <strong>These are different people, kept apart on purpose rather than merged
      into one.</strong></p>
      <ul>{sameName.map((q) => (
        <li><a href={u("/people/" + q.slug)}>{p.living ? clean(q.name) : q.name}</a>
          <span class="small"> — {q.household || (q.living ? ("living" + (q.place ? ", " + q.place : "")) : "from the family tree")}</span></li>
      ))}</ul>
    </>
  ) : null}

  <p class="small" style="margin-top:2rem"><a href={u("/people/")}>← All the people</a></p>
</Base>

<style>
  .pp { margin: 1rem 0; }
  .pp-row { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: .6rem; align-items: flex-start; }
  .pp-fig { margin: 0; flex: 1 1 220px; max-width: 320px; }
  .pp-fig img { display: block; width: 100%; height: auto; max-height: 360px; object-fit: contain; background: var(--panel-2); border: 1px solid var(--rule); }
  .pp-fig figcaption { margin-top: .35rem; font-size: .9rem; line-height: 1.35; }
</style>
