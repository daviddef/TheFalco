---
import Base from "../../layouts/Base.astro";
import { u } from "../../lib/url.js";
import { md } from "../../lib/md.js";
import { people, bySlug } from "../../lib/people.js";
import households from "../../data/households.json";
import plates from "../../data/plates.json";
import EraNote from "@daviddef/archive-kit/components/EraNote.astro";
import { eraAt, plainYear } from "@daviddef/archive-kit/lib/era.js";
import eraSnapshot from "../../data/era-snapshot.json";
import HouseholdTree from "../../components/HouseholdTree.astro";
import PersonPage from "@daviddef/archive-kit/components/PersonPage.astro";
import PersonSection from "@daviddef/archive-kit/components/PersonSection.astro";
import "@daviddef/archive-kit/styles/persontree.css";
import "@daviddef/archive-kit/styles/personpage.css";
import PS from "@daviddef/archive-kit/data/public-sources.json";
import { isLiving as isLivingKit, isHeldOut as isHeldOutKit } from "@daviddef/archive-kit/lib/person.js";
import PersonStory from "@daviddef/archive-kit/components/PersonStory.astro";
import PersonRootsViews from "@daviddef/archive-kit/components/PersonRootsViews.astro";
import { storyOf, hasStory, GRADE_SAY } from "@daviddef/archive-kit/lib/personstory.js";
import rootsLinks from "../../../public/roots-links.json";
import directLine from "../../data/direct-line.json";

export function getStaticPaths() {
  return people.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const clean = (s) => String(s||"").replace(/\s*\(.*?\)\s*/g," ").replace(/\s+/g," ").trim();

/* THE PAGE IS THE KIT'S PersonPage (4 November 2026, people pages v2): the header, the family chart, "What the record says", "Where this comes from",
   "Others of the same name", "Photographs and papers" and "Notes and corrections" are the estate's one set of sections, in the estate's order and with the
   estate's anchors; what this archive adds goes in the slots, or after them as a titled "more" section. `living` is written by tools/build_people.py with
   the kit's one test; the kit's rule is asked as well, and a page is a living person's if EITHER says so. */

/* line.json's notes are written in markdown, and the dek is plain text — the
   asterisks were being printed literally under the name. Take the first
   sentence and drop the emphasis marks. */
const plain = (s) => String(s || "").replace(/\*\*(.*?)\*\*/g, "$1").replace(/[*_`]/g, "");
const firstSentence = (s) => {
  const t = plain(s).trim();
  const m = t.match(/^[\s\S]*?[.!?](?=\s|$)/);
  return (m ? m[0] : t).trim();
};

const sameName = people.filter((q) => q.slug !== p.slug && clean(q.name) === clean(p.name));
const ownHouse = p.household
  ? households.find((h) => h.name.split(/\s*&\s*/).some((n) => clean(n) === clean(p.name)))
  : null;

/* THE PICTURES THAT BELONG TO THIS PERSON. A plate names the people it shows in
   its «who» list (person slugs); the page draws them. No photograph is shown for
   a living person whatever the data says. */
const mine = p.living ? [] : plates
  .filter((x) => (x.who || []).includes(p.slug))
  .sort((a, b) => (b.k === "photo") - (a.k === "photo"));   // pictures of the person first, papers after
const plateId = (x) => String(x.f).replace(/\.jpg$/, "");

/* AN «AT THE TIME» NOTE beside a dated place (kit/docs/era-notes.md; David, 18 October 2026): who held that ground in that year, from
   the Record Atlas's REGION eras, as this archive committed them (src/data/era-snapshot.json, rebuilt deliberately by
   tools/build_era.py --snapshot; the place -> region table is data/era-ground.tsv). Context about the ground, never a claim about
   the family. NEVER on a living person's page (the event list is not drawn for them at all; the guard is here as well, and the
   build gate check:era fails any note found on a living or noindex page). Two places print a date and a place together: a register
   event (date, place), and the born / died line (the tree's place, with the tree's date in the lifespan above). The year is read
   off the date the page prints, and plainYear refuses it unless the whole date is a plain one («23 Jan 1865», «Jul 1972», «1802»):
   «before 21 Jan 1860», «c. 1845», «dead by 1 Sep 1878», «13 [Nov] 1855» give no note, and eraAt gives none for a year within
   max(5, the Atlas's margin) years of an era's start or end (an approximate era is used only well inside its bounds, kit rule l), for an
   era contested about its regime, an era the Atlas labels as shorthand (before 1806) or a place with no region. */
const noNotes = !!p.living;
const MONTH_FIRST = /^([A-Za-z]{3,9})\.?\s+(\d{1,2})\s+(\d{4})$/;      // the tree writes «Nov 12 1807»; the registers «12 Nov 1807»
const dayFirst = (d) => { const t = String(d || "").trim().replace(/\s+/g, " "); const m = MONTH_FIRST.exec(t); return m ? `${m[2]} ${m[1]} ${m[3]}` : t; };
const yearOf = (d) => { const m = /(\d{4})$/.exec(String(d || "").trim()); return m ? Number(m[1]) : null; };
const eraOn = (place, date) => (noNotes || !place || !date) ? null : eraAt(eraSnapshot, place, plainYear(dayFirst(date), yearOf(dayFirst(date))));
const bornEra = !p.living ? eraOn(p.bp, p.b) : null;
const diedEra = !p.living ? eraOn(p.dp, p.d) : null;

/* THE CHART'S DATES. The tree writes «10 Jul 1850», «Nov 12 1807», «Jul 1972», «1802»; the chart draws a day or a year. A month with no day is kept to the
   year. A phrase («before 10 Nov 1864», «dead by 1 Sep 1878») is not a date the chart can draw: the record says it in words, and the year it holds still
   goes to the living rule. */
const MON = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
const monIdx = (m) => MON.findIndex((x) => x.toLowerCase() === String(m).slice(0, 3).toLowerCase());
const gedYear = (v) => { const m = /\b(1[0-9]\d\d|20\d\d)\b/.exec(String(v ?? "")); return m ? Number(m[1]) : null; };
const canonDate = (v) => {
  const t = dayFirst(v);
  if (!t) return undefined;
  let m;
  if (/^\d{4}$/.test(t)) return t;
  if ((m = /^(\d{1,2}) ([A-Za-z]{3,9}) (\d{4})$/.exec(t))) return monIdx(m[2]) < 0 ? m[3] : `${+m[1]} ${MON[monIdx(m[2])]} ${m[3]}`;
  if ((m = /^([A-Za-z]{3,9}) (\d{4})$/.exec(t))) return monIdx(m[1]) < 0 ? undefined : m[2];
  return undefined;
};
const rawB = p.b || null, rawD = p.d || null;
const kitDates = { born: canonDate(rawB), died: canonDate(rawD) };
const KLIVE = !p.living && isLivingKit({ id: p.slug, ...kitDates, birthYear: gedYear(rawB) ?? undefined, deathRecorded: !!rawD || undefined, citations: [] }, { now: new Date().getFullYear(), sources: PS });
if (KLIVE) throw new Error(`people/${p.slug}: the kit's living rule says this person is living but people.json does not (b ${rawB}, d ${rawD}); decide it in tools/build_people.py, not here`);

/* THE CHART'S ROWS. This archive marks the LINK, and keeps every source that carries it: «line» is the archive's own identification (the kit's direct-line
   bar), «register» a record this archive has read, «tree» the family tree, unverified. An edge a register carries is «read», whatever else also carries it. */
const kin = ["parents","spouses","children","siblings"];
const edges = kin.flatMap((b) => p[b] || []);
const fromRegister = edges.filter((e) => e.via !== "tree").length;
const fromTree     = edges.filter((e) => e.via === "tree").length;
const relRow = (e, extra = {}) => {
  const r = bySlug.get(e.slug);
  const live = !!(r && r.living);
  return {
    slug: e.slug || undefined, name: e.name,
    href: e.slug ? u("/people/" + e.slug) : undefined,
    ...(live ? { saidLiving: true } : { born: canonDate(r?.b), died: canonDate(r?.d), birthYear: gedYear(r?.b) ?? undefined, deathRecorded: !!r?.d || undefined }),
    source: live ? "" : (e.vias || [e.via]).some((v) => v === "register") ? "read" : "tree",
    line: e.via === "line" || (e.vias || []).includes("line") || undefined,
    superseded: e.superseded ? true : undefined,
    ...extra };
};
const RELATIONS = {
  parents: (p.parents || []).map((e) => relRow(e)),
  spouses: (p.spouses || []).map((e) => relRow(e, { mar: "married" })),
  children: (p.children || []).map((e) => relRow(e)),
  siblings: (p.siblings || []).map((e) => relRow(e)),
};
const KPERSON = p.living
  ? { id: p.slug, slug: p.slug, name: p.name, saidLiving: true, town: "", country: "", place: p.place || "", relations: RELATIONS }
  : { id: p.slug, slug: p.slug, name: p.name, ...kitDates, birthYear: gedYear(rawB) ?? undefined, deathRecorded: !!rawD || undefined, relations: RELATIONS, citations: [] };


/* STORY MODE (people pages v2, 5 November 2026; PERSON-PAGE-SPEC.md section 2a). A person whose story has anything to tell (the kit's hasStory: a parent,
   a grandparent, a brother or sister, a child, or a note the archive wrote about them) is drawn as the kit's timeline, whose first stop, «Where they came from»,
   is the family, and not as a chart; so is every person Roots & Routes draws, because «Where they lived» is a story-mode section. A person with nothing to tell
   (no relative, no note, not on Roots & Routes) stays a chart page, which says so. The family is the same relatives the chart would draw, under the kit's one
   living rule: a living relative is a name and a relationship and nothing else, and a relative the rule holds out is not drawn at all. The archive has no sex
   for anybody, so a parent is «Parent», not «Father» or «Mother». The words of a chapter are the archive's own (line.json's note, cut at its bold leads by the
   kit's chaptersOf); nothing is rewritten. */
const RULE = { now: new Date().getFullYear(), sources: PS };
const relCanon = (q, extra = {}) => ({ id: q.slug, born: canonDate(q.b), died: canonDate(q.d), birthYear: gedYear(q.b) ?? undefined, deathRecorded: !!q.d || undefined,
  saidLiving: q.living ? true : undefined, citations: [], ...extra });
const relLiving = (q) => !!q.living || isLivingKit(relCanon(q), RULE);
const relHeld = (q) => !q.living && isHeldOutKit(relCanon(q), { ...RULE, parentLiving: (q.parents || []).some((x) => { const pq = bySlug.get(x.slug); return pq && relLiving(pq); }) });
const yearIf = (v) => (canonDate(v) ? gedYear(v) : null);
const cardOf = (e, rel) => {
  const q = bySlug.get(e.slug);
  if (!q || e.superseded || relHeld(q)) return null;
  const live = relLiving(q);
  const b = yearIf(q.b), d = yearIf(q.d);
  const read = (e.vias || [e.via]).some((v) => v === "register");
  return { id: q.slug, rel, living: live, name: q.name, place: "", sex: undefined,
    dates: live ? "" : d ? `${b || "?"} – ${d}` : b ? `${b} –` : "", href: u("/people/" + q.slug + "/"),
    link: live ? undefined : { grade: read ? "doc" : "tree" }, _by: b || 9999 };
};
const byBirth = (a, b) => a._by - b._by;
const cards = (list, rel) => (list || []).map((e) => cardOf(e, rel)).filter(Boolean);
const FAM = (() => {
  if (p.living) return null;
  const parents = cards(p.parents, "Parent");
  const grand = [];
  for (const e of p.parents || []) { const q = bySlug.get(e.slug); if (q && !e.superseded && !relHeld(q) && !relLiving(q)) grand.push(...cards(q.parents, "Grandparent")); }
  return { parents, grand, hasGrand: grand.length > 0, siblings: cards(p.siblings, "Brother or sister").sort(byBirth), children: cards(p.children, "Child").sort(byBirth),
           spouses: cards(p.spouses, "Married to") };
})();
/* line.json writes some paragraph breaks as the two characters backslash and n (62 of them in the first generation's note alone, and the same text prints them on
   /direct-line/); they are turned into the line breaks they stand for so the kit can cut the note at its bold leads. No word is touched. */
const NOTE = !p.living && p.line && p.line.note ? String(p.line.note).replace(/\\n/g, "\n") : "";
/* The kit's chaptersOf cuts at every bold lead that opens a SENTENCE, which is right for notes whose bold phrases are headings; here the bold phrases are
   emphasis inside a sentence (**ANGELA FALCO**, **8 September 1814**), and it cut notes mid-sentence into fragments that begin with a comma. So the chapters are the
   note's own paragraphs, each under the bold lead that opens it where that lead is a short heading; the kit's storyOf still places them on the timeline. */
/* A note written as a research document (a markdown heading, a quotation block or a rule: the first generation's) is not cut: this archive's md() draws those
   characters as they are, which /direct-line/ already shows for it, and cutting would put them on every card. It stays on /direct-line/, linked from the page. */
const RAW_MD = /(^|\n)(#{1,4} |> |---)/.test(NOTE);
const CHAPTERS = RAW_MD ? [] : NOTE.split(/\n{2,}/).map((x) => x.trim()).filter(Boolean).map((para) => {
  const m = para.match(/^\*\*([^*]+?)\*\*\s*/);
  const lead = m ? m[1].trim() : "";
  return lead && lead.split(/\s+/).length <= 14 && para.length > m[0].length ? { title: lead.replace(/[.\s]+$/, ""), body: para.slice(m[0].length).trim(), grade: null } : { title: "", body: para, grade: null };
});
const STORY = p.living ? [] : storyOf(CHAPTERS, FAM, [], { b: yearIf(p.b), d: yearIf(p.d) }, []);
const inRoots = !p.living && (rootsLinks.people || []).includes(p.slug);
const hasSpouse = !!(FAM && FAM.spouses.length);
const STORYMODE = !p.living && (hasStory(STORY) || hasSpouse || inRoots);
if (STORYMODE && hasSpouse) {
  // the kit's stops have no place for a marriage: it is its own stop, before the death and what they left behind
  const at = STORY.findIndex((x) => ["death", "legacy", "about"].includes(x.key));
  STORY.splice(at < 0 ? STORY.length : at, 0, { key: "life", label: "Marriage", when: "", people: FAM.spouses, plabel: "Married to", cards: [] });
}

/* The tree carries three separate people called Simone Zampiello, all entered
   as brothers of one man. Almost certainly one person duplicated — but this
   archive does not merge records on a name, so they are shown as they are and
   the duplication is named. */
const clash = (rows) => {
  const seen = {};
  for (const r of rows) seen[r.name] = (seen[r.name] || 0) + 1;
  return Object.entries(seen).filter(([, n]) => n > 1).map(([n]) => n);
};
const clashChildren = clash(p.children || []);
const clashOther = [...new Set([...clash(p.siblings || []), ...clash(p.parents || []), ...clash(p.spouses || [])])];
const superseded = edges.filter((e) => e.superseded);

/* A PAGE THAT DRAWS NOTHING MAKES A CLAIM IN SILENCE. The REASON is classified in the data by build_people.py, because the reasons are not interchangeable
   and only some of them are gaps this archive could close. */
const empty = !edges.length;
const WHY = {
  "ancestor-in-another-act":
    "This person is named inside somebody else's act — as a grandparent, in the «del fu» clause that gives a parent's own father. No household here holds them in their own right, and no act read so far names their spouse or their other children. The page exists because a record names them.",
  "attended-the-act":
    "This person stood at an act and is not kin to anyone in it — a witness, a declarant, or the midwife. This archive keeps them because who a family called on is evidence of its own, and because the same names recur across households.",
  "married-in":
    "This person is known from the household this archive names them in, and from nothing else yet. No act read here gives them a parent, a child or a sibling of their own.",
  "kin-named-only-in-the-household-name":
    "Their kin are named — in the name of the household this archive files them under — but those people hold no record of their own here, so there is no page to draw a line to. This is a gap this archive could close, not an absence of evidence.",
  "stated-but-not-drawn":
    "The act states a relationship that this chart does not yet draw. This person is named at a marriage as a parent or a sibling of one of the spouses, and the person-builder does not make an edge from that role. The relationship is in the record, not on this chart.",
  "no-edge-recorded":
    "No act read here puts this person beside anyone else. They are recorded because a document names them, and the document names them alone.",
};
const why = empty ? WHY[p.noKin] || WHY["no-edge-recorded"] : null;
const emptyText = why ? "This chart is empty, and that is a statement rather than an omission. " + why : null;

/* What to put under the name. A living person gets their place in the family and
   their town and country, and nothing else — no dates, no records. */
const dek = p.living
  ? "A living relative. This archive shows their name, their place in the family and their town and country, and nothing more."
  : p.gen
  ? firstSentence(p.line.note)
  : p.household
  ? `Recorded in the household of ${p.household}.`
  : edges.length
  ? "Known from the family tree. No register act has been read for this person yet."
  : "Named in this archive, with no relationship recorded for them yet.";
---
{p.living ? (
<Base title={p.name} noautolink noindex ownHeader dek={dek}>
  <PersonPage person={KPERSON} peopleHref={u("/people/")} directLine={directLine} storyHref={u("/story/")} />
</Base>
) : (
<Base title={p.name} noautolink ownHeader dek={dek}>
  <PersonPage person={KPERSON} lede={dek} peopleHref={u("/people/")} registerHref={u("/register/") + "?q=" + encodeURIComponent(clean(p.name))}
              directLine={directLine} storyHref={u("/story/")} emptyText={emptyText}>

    {STORYMODE && <Fragment slot="story"><PersonStory stages={STORY} md={(x) => `<p>${md(x, u)}</p>`} gradeSay={GRADE_SAY} u={u} /></Fragment>}
    {STORYMODE && inRoots && <Fragment slot="where"><PersonRootsViews pid={p.slug} u={u} /></Fragment>}

    {/* THE CHART'S OWN NOTES: a retracted claim kept in the open, a date retired from the chart, and the same name twice in one row */}
    {/* In story mode there is no chart, so the same notes stand in «Notes and corrections», where the kit puts them. */}
    <Fragment slot={STORYMODE ? "notes" : "chart-notes"}>
      {superseded.length ? (
        <p class="warn"><strong>{STORYMODE ? "One claim about this person was retracted, and is kept here in the open, not drawn in the family above." : "One claim here is drawn struck through, and left in place on purpose."}</strong>
        {" " + superseded[0].superseded} <strong>The archive corrects in the open rather than deleting</strong>{STORYMODE ? "." : ",\n        so the discarded parentage stays visible beside the one that replaced it."}</p>
      ) : null}
      {p.retiredDates ? Object.values(p.retiredDates).map((r) => (
        <p class="warn"><Fragment set:html={md(r.reason, u)} /> <strong>The archive corrects in the open rather than deleting</strong>,
        so the discarded date is kept here and not drawn on the chart.</p>
      )) : null}
      {clashChildren.length ? (
        <p class="warn"><strong>Two children here carry one name</strong> — {clashChildren.join(", ")}.
        In this parish that is usually not an error: <strong>a child who died was very often replaced by
        a later child given the same name</strong>. Luigi Cioffi and Mariantonia Venafra buried a
        Gaetana in 1839 and another Gaetana, aged four, in 1843. <strong>It is also exactly how a
        records-matcher invents one person out of two</strong>, which is why they are kept apart here
        and the reader is told.</p>
      ) : null}
      {clashOther.length ? (
        <p class="warn"><strong>More than one person in this row carries the same name</strong> —
        {" " + clashOther.join(", ")}. That is what the source says. <strong>This archive does not merge
        records on a name</strong>, so they are drawn separately even where one duplicated entry is the
        likelier explanation.</p>
      ) : null}
    </Fragment>

    {/* WHAT THE RECORD SAYS */}
    <Fragment slot="record">
      {p.events && p.events.length ? (
        <ul style="margin:.4rem 0">
          {p.events.map((e) => (
            <li style="margin:.6rem 0">
              <strong>{e.event}</strong>{e.date && e.date !== "—" ? <span> — {e.date}</span> : null}
              {e.place ? <span>, {e.place}</span> : null}
              {e.place ? <EraNote era={eraOn(e.place, e.date)} /> : null}
              {e.evidence ? <div class="small" style="margin-top:.25rem">“<Fragment set:html={md(e.evidence, u)} />”</div> : null}
              {e.ark ? <div class="small mono">{e.ark}</div> : null}
            </li>
          ))}
        </ul>
      ) : (
        <p class="small">No act has been read for this person. What is known of them comes from the
        family tree, and is <strong>unverified</strong> —
        <a href={u("/register/") + "?q=" + encodeURIComponent(clean(p.name))}>search the register for the name →</a></p>
      )}
      {(p.bp || p.dp) && (bornEra || diedEra) ? (
        <div class="small" style="margin:.4rem 0">
          {p.bp ? <div><strong>born</strong> {p.bp}<EraNote era={bornEra} /></div> : null}
          {p.dp ? <div style="margin-top:.2rem"><strong>died</strong> {p.dp}<EraNote era={diedEra} /></div> : null}
        </div>
      ) : (p.bp || p.dp) ? (
        <p class="small">{p.bp ? <span><strong>born</strong> {p.bp}</span> : null}
        {p.bp && p.dp ? " · " : null}
        {p.dp ? <span><strong>died</strong> {p.dp}</span> : null}</p>
      ) : null}
    </Fragment>

    {/* WHERE THIS COMES FROM */}
    <Fragment slot="sources">
      <p class="small">
        {fromRegister ? <span><strong>{fromRegister}</strong> of the {edges.length} relationships
          shown above {fromRegister === 1 ? "is" : "are"} written in a record this archive has read.
        </span> : null}
        {fromTree ? <span> <strong>{fromTree}</strong> {fromTree === 1 ? "comes" : "come"} from the
          family tree and {fromTree === 1 ? "is" : "are"} <strong>unverified</strong>.</span> : null}
        {!edges.length ? <span>No relationship is recorded for this person.</span> : null}
      </p>
      {p.mergedOn ? (
        <p class="small"><strong>This page joins two records</strong> — one from the registers, one
        from the family tree — matched on <strong>{p.mergedOn}</strong>.
        {p.mergedOn === "name alone"
          ? " No date confirms the join. It is the only person of this name on either side, which is why it was made, and it is said here rather than hidden."
          : " Their years agree, which is what allowed the join."}</p>
      ) : null}
      {p.household ? (
        <p class="small"><strong>Household:</strong> <a href={u("/households/")}>{p.household}</a></p>
      ) : null}
      {p.gen ? <p class="small"><a href={u("/direct-line/") + "#gen-" + p.gen}>See this generation on the spine →</a></p> : null}
      <p class="small"><a href={u("/register/") + "?q=" + encodeURIComponent(clean(p.name))}>Every record naming {clean(p.name)} →</a></p>
    </Fragment>

    {sameName.length ? (
      <Fragment slot="namesakes">
        <p class="small">This parish repeats its names relentlessly — there are three Maria Falco and
        four Pasquale. <strong>These are different people, kept apart on purpose rather than merged
        into one.</strong></p>
        <ul>{sameName.map((q) => (
          <li><a href={u("/people/" + q.slug)}>{q.name}</a>
            <span class="small"> — {q.household || (q.living ? ("living" + (q.place ? ", " + q.place : "")) : "from the family tree")}</span></li>
        ))}</ul>
      </Fragment>
    ) : null}

    {mine.length ? (
      <Fragment slot="media">
        <div class="pp-row">
          {mine.map((x) => (
            <figure class="pp-fig">
              <a href={u("/documents/") + "#" + plateId(x)}><img src={u("/plates/" + x.f)} alt={x.t} loading="lazy" /></a>
              <figcaption>
                <strong>{x.t}</strong>
                {x.when ? <span class="small mono"> · {x.when}</span> : null}
                <span class="small"> — <a href={u("/documents/") + "#" + plateId(x)}>caption and source →</a></span>
              </figcaption>
            </figure>
          ))}
        </div>
      </Fragment>
    ) : null}

    {ownHouse ? (
      <PersonSection kind="more" title="The household as the registers built it">
        <HouseholdTree household={ownHouse} years />
      </PersonSection>
    ) : null}
  </PersonPage>
</Base>
)}
<style>
  .pp-row { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: .6rem; align-items: flex-start; }
