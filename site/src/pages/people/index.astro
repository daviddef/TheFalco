---
import Base from "../../layouts/Base.astro";
import { u } from "../../lib/url.js";
import { people } from "../../lib/people.js";
import register from "../../data/register.json";

const clean = (s) => String(s || "").replace(/\s*\(.*?\)\s*/g, " ").replace(/\s+/g, " ").trim();

/* Person pages exist only for the people actually reconstructed into a household.
   Everyone else is a record with a source. Both belong on this page. */
const slugByName = new Map();
for (const p of people) if (!slugByName.has(clean(p.name))) slugByName.set(clean(p.name), p.slug);

const rows = register.map((r) => ({
  name: r.name,
  surname: r.surname || "—",
  detail: r.detail || "",
  source: r.source || "",
  link: r.link || "",
  kind: r.kind || "",
  slug: r.kind === "household" ? slugByName.get(clean(r.name)) : undefined,
}));

const bySurname = {};
for (const r of rows) bySurname[r.surname] = (bySurname[r.surname] || 0) + 1;
const topSurnames = Object.entries(bySurname)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 14);

const distinct = new Set(rows.map((r) => clean(r.name).toLowerCase())).size;
const inHousehold = rows.filter((r) => r.kind === "household").length;
const withLink = rows.filter((r) => r.link).length;
---
<Base title="The people"
      eyebrow="Everyone this archive can name"
      dek={`${rows.length.toLocaleString()} records naming ${distinct.toLocaleString()} distinct people — the whole roster, in one searchable list.`}>

  <div class="card" style="margin-bottom:1.2rem">
    <p><strong>This is everyone.</strong> Every named individual the archive holds, from the Antenati
    indexes, the FamilySearch harvests, the Nudgee burials, the family tree, and the Arienzo registers
    read line by line — in one place, searchable, with the source of each.</p>
    <p style="margin-top:.6rem"><strong>Identity here is by record, not by resolved individual.</strong>
    Two rows may be one person. Where the archive knows they are, it has joined them into a
    household — <strong>{inHousehold} rows</strong> are marked
    <span class="chip doc">household</span> and their names open a <a href={u("/people/")}>person
    page</a>. Everything else is offered as <strong>the lead it is rather than the conclusion it is
    not</strong>.</p>
    <p class="small" style="margin-top:.6rem">Names repeat constantly in this parish — three Maria
    Falco, four Pasquale, three men called Sebastiano Lettieri on one street, five Angela Morgillo.
    <strong>A matching surname is not a match</strong>, and a matching surname with a plausible age is
    still not a match. What joins two records here is a named parent, a named spouse, a stated
    relationship, or a street plus a trade repeated across volumes — the rule is set out under
    <a href={u("/method")}>Method</a>.</p>
  </div>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:.6rem;margin:1rem 0">
    <div class="card" style="padding:10px 14px"><div class="mono" style="font-size:1.5rem">{rows.length.toLocaleString()}</div><div class="small">records</div></div>
    <div class="card" style="padding:10px 14px"><div class="mono" style="font-size:1.5rem">{distinct.toLocaleString()}</div><div class="small">distinct names</div></div>
    <div class="card" style="padding:10px 14px"><div class="mono" style="font-size:1.5rem">{Object.keys(bySurname).length}</div><div class="small">surnames</div></div>
    <div class="card" style="padding:10px 14px"><div class="mono" style="font-size:1.5rem">{inHousehold}</div><div class="small">joined into a household</div></div>
    <div class="card" style="padding:10px 14px"><div class="mono" style="font-size:1.5rem">{withLink.toLocaleString()}</div><div class="small">link to a source</div></div>
  </div>

  <div class="card" style="margin:1.2rem 0">
    <label class="lab" for="q">Search a name, a place, a year, a trade or a source</label>
    <input id="q" type="search" placeholder="Annecchino · Camellara · 1843 · Carfora · colono …"
           style="width:100%;margin-top:.5rem;padding:.6rem .7rem;font-family:var(--sans);
                  font-size:15px;border:1px solid var(--rule-strong);border-radius:4px;
                  background:var(--ground);color:var(--ink)" />
    <div id="chips" style="margin-top:.7rem;display:flex;flex-wrap:wrap;gap:.35rem">
      <button class="fchip on" data-f="all">ALL</button>
      <button class="fchip" data-f="hh">★ IN A HOUSEHOLD</button>
      {topSurnames.map(([sn, n]) => (
        <button class="fchip" data-f={"sur:" + sn}>{sn} <span class="mono small">{n}</span></button>
      ))}
    </div>
    <p class="small" id="count" style="margin-top:.6rem">{rows.length.toLocaleString()} shown</p>
    <p class="small" style="margin-top:.3rem">Grouped by source instead at
    <a href={u("/register")}>the register →</a></p>
  </div>

  <div class="scroll">
    <table id="ptable">
      <thead><tr><th>Name</th><th>Family</th><th>What the record says</th><th>Source</th></tr></thead>
      <tbody>
        {rows.map((r) => (
          <tr class="prow" data-sur={r.surname} data-hh={r.kind === "household" ? "1" : "0"}
              data-hay={(r.name + " " + r.surname + " " + r.detail + " " + r.source).toLowerCase()}>
            <td>
              {r.slug ? <a href={u("/people/" + r.slug)}>{r.name}</a> : r.name}
              {r.kind === "household" ? <><br/><span class="chip doc">household</span></> : null}
            </td>
            <td class="small mono">{r.surname}</td>
            <td class="small">{r.detail}</td>
            <td class="small">{r.link ? <a href={r.link} rel="noopener">{r.source}</a> : r.source}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <style is:inline>
    .fchip {
      font-family: var(--sans); font-size: 11px; letter-spacing: .06em; text-transform: uppercase;
      padding: .3rem .6rem; border: 1px solid var(--rule-strong); border-radius: 3px;
      background: var(--ground); color: var(--ink); cursor: pointer;
    }
    .fchip.on { background: var(--ink); color: var(--ground); border-color: var(--ink); }
    #ptable td { vertical-align: top; }
  </style>

  <script is:inline>
    (function () {
      var q = document.getElementById("q");
      var rows = [].slice.call(document.querySelectorAll(".prow"));
      var count = document.getElementById("count");
      var chips = [].slice.call(document.querySelectorAll(".fchip"));
      var filter = "all";

      function run() {
        var v = q.value.trim().toLowerCase();
        var terms = v ? v.split(/\s+/) : [];
        var shown = 0;
        for (var i = 0; i < rows.length; i++) {
          var r = rows[i], ok = true;
          if (filter === "hh") ok = r.getAttribute("data-hh") === "1";
          else if (filter.indexOf("sur:") === 0) ok = r.getAttribute("data-sur") === filter.slice(4);
          if (ok && terms.length) {
            var hay = r.getAttribute("data-hay");
            for (var j = 0; j < terms.length; j++) {
              if (hay.indexOf(terms[j]) === -1) { ok = false; break; }
            }
          }
          r.style.display = ok ? "" : "none";
          if (ok) shown++;
        }
        count.textContent = shown.toLocaleString() + (shown === 1 ? " shown" : " shown");
      }

      chips.forEach(function (c) {
        c.addEventListener("click", function () {
          chips.forEach(function (x) { x.classList.remove("on"); });
          c.classList.add("on");
          filter = c.getAttribute("data-f");
          run();
        });
      });

      var t;
      q.addEventListener("input", function () { clearTimeout(t); t = setTimeout(run, 120); });

      var pre = new URLSearchParams(location.search).get("q");
      if (pre) { q.value = pre; run(); }
    })();
  </script>
</Base>
