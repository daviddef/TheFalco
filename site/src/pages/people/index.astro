---
import Base from "../../layouts/Base.astro";
import FilterTable from "@daviddef/archive-kit/components/FilterTable.astro";
import { u } from "../../lib/url.js";
import { people } from "../../lib/people.js";
import register from "../../data/register.json";
import line from "../../data/line.json";
import living from "../../data/living.json";
import { writtenUp } from "../../lib/writtenup.js";

const clean = (s) => String(s || "").replace(/\s*\(.*?\)\s*/g, " ").replace(/\s+/g, " ").trim();
const key = (s) => clean(s).replace(/\//g, " ").replace(/\s+/g, " ").trim().toLowerCase();

/* A name gets a person-page link only when EXACTLY ONE person answers to it.
   Where several do — three Maria Falco, two Raffaele Falco — the row goes to
   the name page instead, which lists them and lets the reader choose. The
   archive does not pick for them. */
const slugByName = new Map();
const sharedName = new Set();
for (const p of people) {
  const k = clean(p.name);
  if (slugByName.has(k)) sharedName.add(k); else slugByName.set(k, p.slug);
}
for (const k of sharedName) slugByName.delete(k);

/* RELATIONSHIP TO THE ANCHOR. The MyHeritage tree marks one person «This is you»
   — David — and the Falco line is his WIFE's maternal line, so relationships run
   through her. Generation 9 is her mother, 8 her grandparents, and so on back. */
const maxGen = Math.max(...line.map((g) => g.gen || 0));
function relForGen(gen, female) {
  const depth = maxGen + 1 - gen;                 // 9 → 1, 1 → 9
  const word = female ? "mother" : "father";
  if (depth === 1) return `your wife's ${word}`;
  if (depth === 2) return `your wife's grand${word}`;
  if (depth === 3) return `your wife's great-grand${word}`;
  return `your wife's ${depth - 2}× great-grand${word}`;
}
const relByName = new Map();
for (const g of line) {
  for (const part of String(g.name || "").split("/")) {
    const k = key(part); if (k.length > 3) relByName.set(k, relForGen(g.gen, false));
  }
  for (const part of String(g.spouse || "").split("/")) {
    const k = key(part); if (k.length > 3) relByName.set(k, relForGen(g.gen, true));
  }
}

/* THE SPINE. Generations 1–9 and their spouses, by name. */
const spine = new Set();
for (const g of line) {
  for (const v of [g.name, g.spouse]) {
    for (const part of String(v || "").split("/")) {
      const k = key(part);
      if (k.length > 3) spine.add(k);
    }
  }
}

/* "Attached" kinds: the archive has tied this row to the family, rather than
   merely found the name in a register or an index. */
const ATTACHED = new Set(["household", "tree", "cited", "burial", "file", "record"]);

const TOWNS = ["Arienzo", "Moiano", "Paolisi", "Benevento", "Arpaia", "Forchia",
               "Santa Maria a Vico", "San Felice", "Sant'Agata", "Montesarchio",
               "Durazzano", "Cautano", "Airola", "Napoli", "Caserta", "Acerra",
               "Maddaloni", "Lauro", "Magliano", "Nudgee", "Brisbane", "Australia"];
const BRISBANE = new Set(["Nudgee", "Brisbane", "Australia"]);

const rows = register.map((r) => {
  const hay = (r.detail || "") + " " + (r.source || "");
  let place = "";
  for (const t of TOWNS) if (hay.includes(t)) { place = BRISBANE.has(t) ? "Brisbane" : t; break; }
  const attached = ATTACHED.has(r.kind);
  return {
    name: r.name,
    surname: r.surname || "—",
    detail: r.detail || "",
    source: r.source || "",
    link: r.link || "",
    kind: r.kind || "",
    place: place || "—",
    attached,
    inTree: r.kind === "tree",
    inHousehold: r.kind === "household",
    myLine: attached && spine.has(key(r.name)),
    rel: (attached && relByName.get(key(r.name))) || "",
    living: false,
    slug: slugByName.get(clean(r.name)),
  };
});

/* LIVING PEOPLE — names only. No dates, no places, no links: see tools/build_living.py. */
for (const L of living) {
  rows.push({
    name: L.name, surname: L.surname, detail: "", source: "Family tree — living",
    link: "", kind: "living", place: "—", attached: true, inTree: true,
    inHousehold: false, myLine: L.rel !== "relative", rel: L.rel === "relative" ? "" : L.rel,
    living: true, slug: slugByName.get(clean(L.name)),
  });
}

/* ------------------------------------------------------------------ *
 * FROM RECORDS TO PEOPLE
 *
 * This page and /register were two renderings of the same 10,432 rows, which
 * is genuinely confusing: a reader could not tell what the difference was
 * meant to be. So the split is now real and it is the obvious one —
 *
 *   /people    WHO the archive can name   (one row per person)
 *   /register  WHAT it found              (one row per record)
 *
 * Collapsing is by name, and that is NOT the same as identifying a person.
 * «Pasquale Falco» carries seventy-nine records across sixty years and is
 * certainly several men. Every row therefore says how many records stand
 * behind it and links a page that repeats the warning.
 * ------------------------------------------------------------------ */
const slugify = (x) => String(x).toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "")
  .replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const yearOf = (r) => {
  const m = ((r.detail || "") + " " + (r.source || "")).match(/\b(1[6-9]\d\d|20\d\d)\b/);
  return m ? +m[1] : null;
};

/* Some register rows carry prose in the name field — a whole transcribed act,
   or an editorial note that began a table cell. They are not names, they must
   not become pages, and one of them is 300 characters long. */
const isName = (n) => {
  const t = String(n || "").trim();
  return t.length >= 2 && t.length <= 64 && t.split(/\s+/).length <= 7
      && !/[.;:—]\s|«|»|\bthe\b|\bnot an\b/i.test(t);
};

const folkMap = new Map();
for (const r of rows) {
  const k = key(r.name);
  if (!k || !isName(r.name)) continue;
  if (!folkMap.has(k)) {
    folkMap.set(k, {
      name: r.name, surname: r.surname, n: 0, nLink: 0, years: [], places: {},
      attached: false, inTree: false, inHousehold: false, myLine: false,
      living: false, rel: "", slug: undefined, kinds: new Set(), sources: new Set(),
    });
  }
  const f = folkMap.get(k);
  f.n++;
  if (r.name.length > f.name.length) f.name = r.name;      // keep the fullest form
  if (r.surname && r.surname !== "—" && r.surname !== "?") f.surname = r.surname;
  if (r.link) f.nLink++;
  const y = yearOf(r); if (y) f.years.push(y);
  if (r.place && r.place !== "—") f.places[r.place] = (f.places[r.place] || 0) + 1;
  f.attached ||= r.attached; f.inTree ||= r.inTree; f.inHousehold ||= r.inHousehold;
  f.myLine ||= r.myLine; f.living ||= r.living;
  if (!f.rel && r.rel) f.rel = r.rel;
  if (!f.slug && r.slug) f.slug = r.slug;
  if (r.kind) f.kinds.add(r.kind);
  if (r.source) f.sources.add(r.source);
}

const folk = [...folkMap.values()].map((f) => {
  f.years.sort((a, b) => a - b);
  const lo = f.years[0], hi = f.years[f.years.length - 1];
  const place = Object.entries(f.places).sort((a, b) => b[1] - a[1])[0];
  return {
    ...f,
    span: lo ? (lo === hi ? String(lo) : lo + "–" + hi) : "",
    place: place ? place[0] : "—",
    nameSlug: slugify(f.name.replace(/\s*\(.*?\)\s*/g, " ").replace(/\s+/g, " ").trim()),
    wu: writtenUp(f.surname),
    src: [...f.sources][0] || "",
  };
}).sort((a, b) => a.surname.localeCompare(b.surname) || a.name.localeCompare(b.name));

const count = (fn) => folk.filter(fn).length;
const bySurname = {};
for (const r of folk) bySurname[r.surname] = (bySurname[r.surname] || 0) + 1;
const topSurnames = Object.entries(bySurname)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).slice(0, 12);

const byPlace = {};
for (const r of folk) byPlace[r.place] = (byPlace[r.place] || 0) + 1;
const topPlaces = Object.entries(byPlace)
  .filter(([p]) => p !== "—")
  .sort((a, b) => b[1] - a[1]).slice(0, 9);

const nRecords = rows.length;
const distinct = folk.length;
const nMyLine = count((r) => r.myLine);
const nTree = count((r) => r.inTree);
const nHH = count((r) => r.inHousehold);
const nAttached = count((r) => r.attached);
const nLink = count((r) => r.nLink);
const nLiving = count((r) => r.living);
---
<Base title="The People"
      eyebrow="Everyone this archive can name"
      dek={`${distinct.toLocaleString()} people the archive can name, drawn from ${nRecords.toLocaleString()} records — filterable by family, by place and by name. Every one has a page.`}
      noindex={true}>

  <div class="card" style="margin-bottom:1.2rem">
    <p><strong>This is everyone, one row per person.</strong> Every named individual the archive
    holds — the Antenati indexes, the FamilySearch harvests, the Nudgee burials, the family tree and
    the Arienzo registers read line by line. <strong>Every name here has its own page.</strong></p>
    <p style="margin-top:.6rem"><strong>This page is WHO; <a href={u("/register/")}>the register</a>
    is WHAT.</strong> They used to be two lists of the same ten thousand rows, which helped nobody.
    Now this one answers <em>who can this archive name?</em> — one row each — and the register
    answers <em>what did it find?</em>, one row per record, grouped by surname.</p>
    <p style="margin-top:.6rem"><strong>Most of these people are not your relatives.</strong> Six
    thousand of them were read off the Arienzo death registers act by act: they are the town, not the
    family. Use <span class="chip doc">★ My line</span> and <span class="chip doc">In my tree</span>
    to cut to the people actually attached to this family.</p>
    <p class="small" style="margin-top:.6rem"><strong>A row here is a NAME, not a resolved
    individual.</strong> Records are gathered under a name because they share it, and for no other
    reason. Names repeat relentlessly — three Maria Falco, four Pasquale, three men called Sebastiano
    Lettieri on one street, five Angela Morgillo, and <strong>seventy-nine records carrying «Pasquale
    Falco»</strong>. <strong>A matching surname is not a match</strong>, and a matching surname with a
    plausible age is still not a match. Each page repeats the warning. See
    <a href={u("/method/")}>Method</a>.</p>
  </div>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:.6rem;margin:1rem 0">
    <div class="card" style="padding:10px 14px"><div class="mono" style="font-size:1.5rem">{distinct.toLocaleString()}</div><div class="small">people, each with a page</div></div>
    <div class="card" style="padding:10px 14px"><div class="mono" style="font-size:1.5rem">{nRecords.toLocaleString()}</div><div class="small">records behind them</div></div>
    <div class="card" style="padding:10px 14px"><div class="mono" style="font-size:1.5rem">{nAttached}</div><div class="small">attached to the family</div></div>
    <div class="card" style="padding:10px 14px"><div class="mono" style="font-size:1.5rem">{Object.keys(bySurname).length}</div><div class="small">surnames</div></div>
    <div class="card" style="padding:10px 14px"><div class="mono" style="font-size:1.5rem">{nLink.toLocaleString()}</div><div class="small">link to a source</div></div>
  </div>

    <FilterTable
      unit="people"
      columns={[{ label: "Name" }, { label: "Family", cls: "small mono" }, { label: "Relationship", cls: "small" },
                { label: "Place", cls: "small" }, { label: "Years", cls: "small mono" },
                { label: "Records", cls: "small mono" }, { label: "Written up", cls: "small" }]}
      facets={[
        { key: "grp", label: "Who", all: "Everyone", options: [
          { k: "line", v: "1", label: `★ My line <span class="mono small">${nMyLine}</span>` },
          { k: "tree", v: "1", label: `In my tree <span class="mono small">${nTree}</span>` },
          { k: "hh",   v: "1", label: `In a household <span class="mono small">${nHH}</span>` },
          { k: "att",  v: "1", label: `Attached to the family <span class="mono small">${nAttached}</span>` },
          { k: "liv",  v: "1", label: `Living <span class="mono small">${nLiving}</span>` }] },
        { key: "place", label: "Place", all: "Anywhere",
          options: [...topPlaces.map(([p2, n]) => ({ v: p2, label: `${p2} (${n})` })),
                    { v: "—", label: `No place (${byPlace["—"] || 0})` }] },
        { key: "sur", label: "Surname", all: "Any",
          options: topSurnames.map(([sn, n]) => ({ v: sn, label: `${sn} (${n})` })) },
      ]}
      rows={folk.map((r) => ({
        hay: (r.name + " " + r.surname + " " + r.place + " " + r.span + " " + r.src).toLowerCase(),
        facets: { sur: r.surname, place: r.place, line: r.myLine ? "1" : "0",
                  tree: r.inTree ? "1" : "0", hh: r.inHousehold ? "1" : "0",
                  att: r.attached ? "1" : "0", liv: r.living ? "1" : "0" },
        cells: [
          `<a href="${u(r.slug ? "/people/" + r.slug + "/" : "/who/" + r.nameSlug + "/")}">${r.name}</a>` +
            (r.living ? '<br><span class="chip doc">living</span>'
             : r.myLine ? '<br><span class="chip doc">★ my line</span>'
             : r.slug ? '<br><span class="chip doc">identified</span>'
             : r.inHousehold ? '<br><span class="chip doc">household</span>'
             : r.inTree ? '<br><span class="chip doc">tree</span>' : ""),
          r.surname, r.rel, r.place === "—" ? "" : r.place, r.span,
          `<a href="${u(r.slug ? "/people/" + r.slug + "/" : "/who/" + r.nameSlug + "/")}">${r.n}</a>` +
            (r.nLink ? `<span class="dim"> · ${r.nLink} linked</span>` : '<span class="dim"> · none linked</span>'),
          r.wu ? `<a href="${u(r.wu[0])}">${r.wu[1]}</a>` : "",
        ],
      }))} />
        <p class="small"><strong>Looking for the records themselves?</strong>
    <a href={u("/register/")}>The register →</a> lists all {nRecords.toLocaleString()} of them,
    one row per record, grouped by surname, each linked to its source.</p>
  </div>

  <div class="card" style="margin:1rem 0;border-left:3px solid var(--rule-strong)">
    <p class="small"><strong>What “★ My line” means, exactly.</strong> It is the {nMyLine} people whose
    name matches one of the eighteen names in the direct spine — the nine generations and their
    spouses — <strong>and</strong> which the archive has actually attached to this family through a
    household, the tree, a cited document or a burial. <strong>Name-matching alone was deliberately
    not used:</strong> doing that would have pulled in another {210 - nMyLine} rows, most of them
    Antenati index hits for every Pasquale Falco in the Valle Caudina. Those are leads, and they are
    not your line until a record says so.</p>
  </div>


</Base>
