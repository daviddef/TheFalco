---
import Base from "../../layouts/Base.astro";
import { u } from "../../lib/url.js";
import { people } from "../../lib/people.js";

const clean = (s) => String(s || "").replace(/\s*\(.*?\)\s*/g, " ").replace(/\s+/g, " ").trim();
const surnameOf = (n) => {
  const parts = clean(n).split(" ").filter(Boolean);
  if (!parts.length) return "—";
  const last = parts[parts.length - 1];
  const prev = parts[parts.length - 2];
  if (prev && ["di", "de", "del", "della", "d'", "lo", "la"].includes(prev.toLowerCase()))
    return (prev + " " + last).toUpperCase();
  return last.toUpperCase();
};

const rows = [...people]
  .map((p) => {
    const dates = p.events.map((e) => e.date).filter((d) => d && d !== "—");
    const places = [...new Set(p.events.map((e) => e.place).filter((x) => x && x !== "—"))];
    return {
      ...p,
      surname: surnameOf(p.name),
      dates: [...new Set(dates)],
      place: places[0] || "",
      evcount: p.events.length,
    };
  })
  .sort((a, b) => a.surname.localeCompare(b.surname) || a.name.localeCompare(b.name));

const bySurname = {};
for (const r of rows) bySurname[r.surname] = (bySurname[r.surname] || 0) + 1;
const topSurnames = Object.entries(bySurname)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 10);

const inLine = rows.filter((r) => r.gen).length;
const withEvents = rows.filter((r) => r.evcount).length;
const roleCounts = {};
for (const r of rows) roleCounts[r.role || "—"] = (roleCounts[r.role || "—"] || 0) + 1;
---
<Base title="The people"
      eyebrow="Everyone this archive has joined into a family"
      dek={`${rows.length} people reconstructed into households from the words of a record — each with a page, whether they continued the line or not.`}>

  <div class="card" style="margin-bottom:1.2rem">
    <p>These are the people this archive has actually <strong>joined into families</strong> — where a
    record names a parent, a spouse or a stated relationship, and the join can be shown. They are the
    minority of what has been found. Every other named individual — some eight thousand of them, from
    the Antenati indexes, the record harvests and the register sweeps — is listed with its source at
    <a href={u("/register")}><strong>The register</strong></a>, and labelled there as the lead it is
    rather than the conclusion it is not.</p>
    <p class="small" style="margin-top:.6rem"><strong>Identity here is by household, not by name.</strong>
    Names repeat constantly in this parish — three Maria Falco, four Pasquale, three men called
    Sebastiano Lettieri on one street — so a person is a name <em>inside a household</em>, and two of
    them are never silently merged. That is why the same name can appear twice below with different
    households: they are different people, and the archive says so rather than choosing.</p>
  </div>

  <div class="grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:.6rem;margin:1rem 0">
    <div class="card" style="padding:10px 14px"><div class="mono" style="font-size:1.5rem">{rows.length}</div><div class="small">people</div></div>
    <div class="card" style="padding:10px 14px"><div class="mono" style="font-size:1.5rem">{inLine}</div><div class="small">in the direct line</div></div>
    <div class="card" style="padding:10px 14px"><div class="mono" style="font-size:1.5rem">{withEvents}</div><div class="small">with a dated event</div></div>
    <div class="card" style="padding:10px 14px"><div class="mono" style="font-size:1.5rem">{Object.keys(bySurname).length}</div><div class="small">surnames</div></div>
  </div>

  <div class="card" style="margin:1.2rem 0">
    <label class="lab" for="q">Search a name, a household, a place or a year</label>
    <input id="q" type="search" placeholder="Camellara · Rivetti · 1843 · Morgillo …"
           style="width:100%;margin-top:.5rem;padding:.6rem .7rem;font-family:var(--sans);
                  font-size:15px;border:1px solid var(--rule-strong);border-radius:4px;
                  background:var(--ground);color:var(--ink)" />
    <div id="chips" style="margin-top:.7rem;display:flex;flex-wrap:wrap;gap:.35rem">
      <button class="fchip on" data-f="all">ALL</button>
      <button class="fchip" data-f="line">★ DIRECT LINE</button>
      {topSurnames.map(([sn, n]) => (
        <button class="fchip" data-f={"sur:" + sn}>{sn} <span class="mono small">{n}</span></button>
      ))}
    </div>
    <p class="small" id="count" style="margin-top:.6rem">{rows.length} people shown</p>
  </div>

  <div class="scroll">
    <table id="ptable">
      <thead><tr>
        <th>Name</th><th>Gen</th><th>Role</th><th>Household</th><th>Dates</th><th>Place</th>
      </tr></thead>
      <tbody>
        {rows.map((r) => (
          <tr class="prow"
              data-sur={r.surname}
              data-line={r.gen ? "1" : "0"}
              data-hay={(r.name + " " + r.household + " " + r.surname + " " + (r.role || "") + " " +
                         r.dates.join(" ") + " " + r.place).toLowerCase()}>
            <td><a href={u("/people/" + r.slug)}>{r.name}</a></td>
            <td class="mono small">{r.gen ? <span class="chip doc">gen {r.gen}</span> : ""}</td>
            <td class="small">{r.role && r.role !== "—" ? r.role : ""}</td>
            <td class="small">{r.household}</td>
            <td class="mono small">{r.dates.join(" · ")}</td>
            <td class="small">{r.place}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <style is:inline>
    .fchip {
      font-family: var(--sans); font-size: 11px; letter-spacing: .06em; text-transform: uppercase;
      padding: .3rem .6rem; border: 1px solid var(--rule-strong); border-radius: 3px;
      background: var(--ground); color: var(--ink); cursor: pointer;
    }
    .fchip.on { background: var(--ink); color: var(--ground); border-color: var(--ink); }
    #ptable td { vertical-align: top; }
  </style>

  <script is:inline>
    (function () {
      var q = document.getElementById("q");
      var rows = [].slice.call(document.querySelectorAll(".prow"));
      var count = document.getElementById("count");
      var chips = [].slice.call(document.querySelectorAll(".fchip"));
      var filter = "all";

      function run() {
        var v = q.value.trim().toLowerCase();
        var terms = v ? v.split(/\s+/) : [];
        var shown = 0;
        for (var i = 0; i < rows.length; i++) {
          var r = rows[i];
          var ok = true;
          if (filter === "line") ok = r.getAttribute("data-line") === "1";
          else if (filter.indexOf("sur:") === 0) ok = r.getAttribute("data-sur") === filter.slice(4);
          if (ok && terms.length) {
            var hay = r.getAttribute("data-hay");
            for (var j = 0; j < terms.length; j++) {
              if (hay.indexOf(terms[j]) === -1) { ok = false; break; }
            }
          }
          r.style.display = ok ? "" : "none";
          if (ok) shown++;
        }
        count.textContent = shown + (shown === 1 ? " person shown" : " people shown");
      }

      chips.forEach(function (c) {
        c.addEventListener("click", function () {
          chips.forEach(function (x) { x.classList.remove("on"); });
          c.classList.add("on");
          filter = c.getAttribute("data-f");
          run();
        });
      });

      var t;
      q.addEventListener("input", function () { clearTimeout(t); t = setTimeout(run, 100); });

      var pre = new URLSearchParams(location.search).get("q");
      if (pre) { q.value = pre; run(); }
    })();
  </script>
</Base>
