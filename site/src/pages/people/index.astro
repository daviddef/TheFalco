---
import Base from "../../layouts/Base.astro";
import { u } from "../../lib/url.js";
import { people } from "../../lib/people.js";
const sorted = [...people].sort((a, b) => a.name.localeCompare(b.name));
const groups = {};
for (const p of sorted) {
  const k = (p.name.match(/[A-Za-z]/) || ["?"])[0].toUpperCase();
  (groups[k] ||= []).push(p);
}
const keys = Object.keys(groups).sort();
const withEvents = people.filter((p) => p.events.length).length;
---
<Base title="The people"
      eyebrow="Everyone this archive can name"
      dek={`${people.length} people reconstructed into households from the words of a record — each with a page, whether they continued the line or not.`}>
  <div class="card" style="margin-bottom:1.4rem">
    <p>These are the people this archive has actually <strong>joined into families</strong>. They are
    the minority of what has been found. Every other named individual — some two thousand of them,
    from the Antenati surname indexes and the record harvests — is listed with its source at
    <a href={u("/register")}><strong>The register</strong></a>, and labelled there as the lead it is
    rather than the conclusion it is not.</p>
  </div>
  {keys.map((k) => (
    <section style="margin:1.4rem 0">
      <h2 style="margin-bottom:.5rem">{k}</h2>
      <div class="grid two">
        {groups[k].map((p) => (
          <div class="card" style="padding:14px 16px">
            <a href={u("/people/" + p.slug)}><strong>{p.name}</strong></a>
            {p.gen ? <span class="chip doc" style="margin-left:.5rem">gen {p.gen}</span> : null}
            <div class="small">{p.household}</div>
            {p.events.length ? <div class="small mono">{p.events.map((e) => e.date).filter((d) => d && d !== "—").join(" · ")}</div> : null}
          </div>
        ))}
      </div>
    </section>
  ))}
</Base>
