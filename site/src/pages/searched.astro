---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
const REPO = "https://github.com/daviddef/TheFalco";

/* What has been read, page by page, and what was in it — including the years
   that held nothing. A null is a result: it is what stops the next person
   reading the same volume again. */
const READ = [
  { kind: "Deaths", year: "1829", ark: "an_ua14331", imgs: 65, falco: 0,
    found: "Nothing. The only year of the eight with no Falco in it at all — not deceased, not parent, not declarant.",
    note: "The null matters: it cuts against a parish entry of 1829 this archive had relied on to show Pasquale was alive. That entry needs re-reading." },
  { kind: "Deaths", year: "1830", ark: "an_ua14332", imgs: 59, falco: 1,
    found: "Rosa Falco, 42, wife of Carlantonio Morgillo — daughter of Matteo Falco and Francesca Crisci. Pasquale's sister.",
    note: "Names the line's founding couple a second time, from a second child, four years before Pasquale's own act." },
  { kind: "Deaths", year: "1831", ark: "an_ua14333", imgs: 62, falco: 1,
    found: "Anna Falco, 13 months, daughter of Michelangelo Falco and Mariantonia Vigliotta. Plus Vincenzo Falco and Giuseppe Falco alive, as declarants.",
    note: "Vincenzo declares it as «parente» where the other declarant is «vicino» — the first kinship joining the line to another Camellara household." },
  { kind: "Deaths", year: "1832", ark: "an_ua14334", imgs: 53, falco: 2,
    found: "Giovanna Falco, 70, daughter of Michele Falco and Vincenza Esposito. Carmina Falco, 6 months, daughter of Francesco Falco and Raffaela Falco.",
    note: "A second founding-generation couple — and a Falco who married a Falco." },
  { kind: "Deaths", year: "1833", ark: "an_ua14335", imgs: 58, falco: 1,
    found: "Pasquale Falco, 3, son of Vincenzo Falco and Andreana Crisci.",
    note: "The first civil record placing that couple together as a household, with an address." },
  { kind: "Deaths", year: "1834", ark: "an_ua14336", imgs: 57, falco: 3,
    found: "PASQUALE FALCO, 1 October — the record the whole search was for. Also Maria Rosa Falco, 16, daughter of Michele; Anna Falco, 8 days, daughter of Michelangelo; and Pasquale Falco, 10 days, son of Vincenzo.",
    note: "All 101 acts of this year are logged individually in the reading log." },
  { kind: "Deaths", year: "1835", ark: "an_ua14337", imgs: 46, falco: 0,
    found: "Nothing.",
    note: "Read in full while hunting Pasquale, and eliminated." },
  { kind: "Deaths", year: "1836", ark: "an_ua14338", imgs: 51, falco: 4,
    found: "Donna Raffaela de Falco, 67, a nun, daughter of Don Francesco Falco, proprietario. Margarita Falco, 60. Salvatore Falco, 14 months, son of Michele. Pasqualina Falco, 10 months, daughter of Francesco.",
    note: "Revealed a gentry Falco branch at Arienzo, spelled «de Falco», never joined to this family." },
  { kind: "Deaths", year: "1816", ark: "an_ua14318", imgs: 47, falco: 0,
    found: "No Falco died. But act 76 names TWO Falco declarants of strada Camellara — Gioacchino Falco, 36, and Giuseppe Falco, 32 — described as «parenti del defunto», and the dead man, Crescenzo Rivetti, is «marito di Angela Falco».",
    note: "A Falco head this archive had never met, and a Falco marriage it did not have. No Raffaele Falco burial here — he turned up in the next volume, on 28 October 1817." },
  { kind: "Deaths", year: "1817", ark: "an_ua14319", imgs: 89, falco: 3,
    found: "THE BURIAL OF THE FIRST RAFFAELE FALCO, 28 October — son of Vincenzo and Andreana, aged about eighteen months, declared by Giuseppe Falco of strada Camellara as a «parente». Also Maria Falco, 24 July, daughter of a Giuseppe Falco and Rosa Sossi neither of them known before; and, in the 1818 acts bound at the back, Angela Majone, daughter of a second Maria Falco.",
    note: "The volume that answered the archive's largest open question. Nearly twice the size of 1816 because 1817 was the famine year after Tambora — whole households die within days of each other." },
  { kind: "Deaths", year: "1818", ark: "an_ua14320", imgs: 55, falco: 0,
    found: "No Falco died. But Giuseppe Falco of strada Camellara declares again on 8 May — thirty-six, contadino — four weeks before his own daughter's birth act gives exactly the same age, trade and street, which proves the five sightings are one man. Also a SECOND Carlantonio Morgillo, older and already dead; an Orazio Morgillo of the right age to be Angela Rosa's father; and Don Giuseppe Rivetti, a priest.",
    note: "Its first eleven images are a second original of acts the 1817 volume already held — two clerks who disagree in detail, which caught a misreading in this archive's own notes." },
  { kind: "Deaths", year: "1819", ark: "an_ua14321", imgs: 37, falco: 3,
    found: "DOMENICO FALCO and ROSARIA FALCO, both on 15 March, eleven hours apart — two children of Giuseppe Falco and Gelsomina Vigliotta dead in one day. And ANGELANDREA RIVETTI, daughter of the late Crescenzo Rivetti and ANGELA FALCO: the only other record anywhere that names Angela.",
    note: "Also Suor Maria Maddalena Rivetti, a nun, daughter of a Don Giuseppe Rivetti — the fourth gentry Rivetti, in a town where the same surname is also full of day-labourers." },
  { kind: "Deaths", year: "1820", ark: "an_ua14322", imgs: 43, falco: 2,
    found: "ANNA FALCO, 23 August, aged twenty-five — «moglie di Arcangelo Crisci … FIGLIA DI PASQUALE FALCO … E DI CHIARA RIVETTI». A daughter of the direct line's generation two that this archive did not have, and a sister of Vincenzo. Also her two-day-old son Fortunato Crisci, in January.",
    note: "Both her parents are named without «fu», so Pasquale Falco and Chiara Rivetti were alive on strada Camellara in August 1820 — the only civil sighting of him between his marriage and his death. From 1820 the printed form also gives the deceased's age, both parents, and each declarant's relationship." },
  { kind: "Deaths", year: "1821", ark: "an_ua14323", imgs: 37, falco: 0,
    found: "Nothing — 77 acts and not one Falco, as deceased, parent, spouse or declarant. But CARMINE RIVETTI, 53, a contadino, «figlio di NICOLA RIVETTI Defunto, di professione CONTADINO, e di ANNA DI RUGGIO Defunta» — a rival and better-fitting candidate for Chiara Rivetti's parents than the gentry couple of 1816.",
    note: "Also a third Carlantonio Morgillo, checked and cleared; and a death in the Regie Prigioni of Arienzo, declared by the gaol's keeper — this archive did not know the town had a prison." },
  { kind: "Deaths", year: "1822", ark: "an_ua14324", imgs: 44, falco: 1,
    found: "ANGELA FALCO, 17 October, aged fifty-one — «vedova di CRESCENZO RIVETTI … FIGLIA DI MATTEO FALCO Defunto … E DI FRANCESCA CRISCI Defunta». A daughter of the founding couple, and a sister of Pasquale.",
    note: "The earliest of three separate children's death acts to name Matteo and Francesca. It also explains why Gioacchino Falco and Giuseppe Falco declared her husband's death in 1816 as «parenti» — they were his wife's brothers." },
  { kind: "Deaths", year: "1823", ark: "an_ua14325", imgs: 64, falco: 3,
    found: "No Falco died. But «GIUSEPPE FALCO FU MATTEO» declares twice on 20 June — the first time the CIVIL series states his parentage outright, confirming from a separate series what the parish books said: he is a son of the late Matteo. Also a third, living Maria Falco, wife of Francesco Cossi.",
    note: "And PAOLO RIVETTI, 50, «figlio del fu Pasquale Rivetti e di Giovanna Perrotta» — the brother of Crescenzo Rivetti, who married Angela Falco. Giovanna Perrotta is named without «fu», so she was still alive in 1823." },
  { kind: "Deaths", year: "1824", ark: "an_ua14326", imgs: 52, falco: 3,
    found: "No Falco died — but atto 8 has PASQUALE FALCO himself, fifty-five, a COLONO of strada Camellara, declaring a neighbour's death beside his brother GIUSEPPE. It is the only record in which the ancestor acts rather than being spoken of. The dead child's mother is a third, living Maria Falco.",
    note: "Also DONN'ANNA QUOTOLO, eighty-eight, widow of Don Nicola Rivetti — one half of the gentry couple that has been a candidate for Chiara Rivetti's parents since 1816, now with her own act, her age and her father." },
  { kind: "Deaths", year: "1825", ark: "an_ua14327", imgs: 39, falco: 4,
    found: "MADDALENA FALCO, seven, and CLEMENTE FALCO, fifteen months — Giuseppe Falco and Antonia di Guida buried two children in nineteen days. Maddalena's civil birth act of 7 June 1818 was already in this archive; she died a week short of her seventh birthday.",
    note: "Giuseppe Falco also declared, for the third time, at a death in the household of Francesco Cossi and a third Maria Falco — and the Cossi declared Maddalena's. Two houses standing for each other through five child deaths, though no act ever says they are kin." },
  { kind: "Deaths", year: "1826", ark: "an_ua14328", imgs: 52, falco: 3,
    found: "MARIA FALCO, thirty-two, on 25 April — «moglie di ALFONSO DIGLIO … figlia di PASQUALE FALCO … e di CHIARA RIVETTI». A second daughter of generation two, and a sister of Vincenzo. Both parents are named WITHOUT «fu», so Pasquale was alive and still a contadino in 1826 — only the second sighting of him between his marriage and his death.",
    note: "And on 28 October, GIUSEPPE FALCO, forty-six, massaro, declares an act BESIDE CARLANTONIO MORGILLO, forty-six, of the same street — the first time in the whole series that a Falco and a Morgillo stand together. Eighty-eight acts read; also five Morgillo buried, three religious houses, a gendarme brigadier and the town's royal notary." },
  { kind: "Births", year: "1816", ark: "an_ua14413", imgs: 66, falco: 2,
    found: "Raffaele Falco, 25 April, son of Vincenzo Falco and Andreana Crisci. Domenico Falco, 25 November, son of a DIFFERENT Giuseppe Falco and Gelsomina Vigliotta, of strada Costa.",
    note: "The 1816 Raffaele unsettled generation four for a time; the 1817 death register has since closed it. The register ran to 123 acts; all 122 fathers read are logged." },
  { kind: "Births", year: "1817", ark: "an_ua14414", imgs: 48, falco: 0,
    found: "No Falco. But two Arcangelo Crisci, aged 52 and 30, declaring births in the same year — which answers a standing question.",
    note: "All 77 fathers read are logged with age, trade and street." },
  { kind: "Births", year: "1818", ark: "an_ua14415", imgs: 85, falco: 2,
    found: "Raffaele Falco, 10 May, son of Vincenzo and Andreana — generation four. Maddalena Falco, 7 June, daughter of Giuseppe Falco and Antonia di Guida, of strada Camellara.",
    note: "Giuseppe is a documented son of Matteo — so a child of the founding couple is placed on the family's street." },
];

const NOT_FOUND = [
  ["The Zampiello and the Annecchino, in FindMyPast",
   "FindMyPast, on subscription, September 2026 — every family surname searched with name variants on, worldwide and filtered to Australia & New Zealand.",
   "Nothing. ZAMPIELLO returns two Australian hits and both are United States war records the region filter has mis-tagged; of 81 Zampiello travel and migration records worldwide, every single one goes to the United States, not one to Australia. ANNECCHINO returns zero in Australia and New Zealand. RAFFAELE FALCO returns zero. The family that reached Brisbane is simply not in this archive — which closes the search rather than opening it."],
  ["The Queensland Falco — a different family",
   "FindMyPast: all 56 Australian birth, marriage and death records for Falco, and all 31 electoral-roll entries, read individually.",
   "Every Queensland Falco belongs to one household in the Burdekin cane country, about 1,200 km north of Brisbane: Giuseppe Falco, born about 1898, who married Mary Rubiolo in 1932 and was buried at Home Hill in 1979, with Bartolomeo, Maria Margherita, Primo, Raymond and Laurence at Ayr. This matters for one of our open questions: the Giuseppe Falco who reached Brisbane on the Palermo in 1925 is NOT this man, and remains untraced."],
  ["Anything new in FindMyPast's Italian records",
   "FindMyPast — Italy Births & Baptisms 1806-1900, Italy Deaths & Burials 1809-1900, Italy Marriages 1809-1900.",
   "Nothing new. Every transcript carries the line «Index (c) IRI. Used by permission of FamilySearch Intl» — these are the FamilySearch index this archive harvested directly long ago, re-hosted. There is no second Italian source here."],
  ["Pasquale Falco's death, in the parish registers",
   "1,145 pages of the Arienzo parish death register, harvested from FamilySearch's full text and searched by name, by OCR variant, and by male-adult-with-age across 1828–1845.",
   "It is not there. It was found only in the civil register, by reading 1834 act by act."],
  ["Pasquale Falco, in the FamilySearch index",
   "All 1,162 Falco records in FamilySearch's index of Caserta civil registration 1809–1866, of which 249 fall in the window.",
   "The only «Pasquale Falco» principals are two Falcone men of other families."],
  ["Maria Rosa Falco's birth",
   "The Arienzo birth registers for 1816, 1817 and 1818, all read act by act.",
   "Absent from all three. She was sixteen at her death in May 1834. Either the age was loose by more than two years, she was born outside Arienzo, or she was baptised without a civil act. Michele Falco of strada Camellara therefore remains undated."],
  ["Matteo Falco's marriage",
   "2,056 transcribed pages of the Arienzo marriage and death registers, searched for a marriage to Francesca Crisci between about 1760 and 1766.",
   "Not found. It would name his father, and it is the line's frontier. His own baptism falls in the gap the register leaves between 1738 and 1761."],
  ["The Arienzo processetti of 1817",
   "Antenati — the marriage supplement file for Vincenzo Falco's marriage of December 1814.",
   "The 1814 volume runs to act 25 and stops; act 26's file is in neither volume. Whether it was never filed, was lost, or sits unscanned is not established."],
  ["Angelo Zampiello's and Filomena Annecchino's births",
   "Antenati — Arpaia births 1895 and Forchia births 1897.",
   "Neither volume was digitised: the shelf-marks run consecutively and skip those years. Both are at the Archivio di Stato di Benevento and must be ordered."],
];
const totalImgs = READ.reduce((a, r) => a + r.imgs, 0);
const totalFalco = READ.reduce((a, r) => a + r.falco, 0);
---
<Base title="What has been read"
      eyebrow="Coverage, including the years that held nothing"
      dek={`Twenty-one annual registers read page by page — ${totalImgs} images, some two thousand acts, ${totalFalco} Falco. This page exists so that a null is not lost: knowing a volume has been read and held nothing is worth as much as knowing what it held.`}>

  <div class="card" style="border-left:3px solid var(--accent)">
    <p><strong>Why record the negatives.</strong> A family archive that only publishes its finds
    invites the next person to repeat every search that failed. Six of the twenty-one volumes below
    contained no Falco deceased at all, and two of those nulls overturned or unsettled something this
    archive had been relying on. Every one of these years is logged act by act in the
    <a href={REPO + "/tree/main/notes"}>reading logs</a>, with each father's age, trade and street.</p>
  </div>

  <h2>Registers read in full</h2>
  <div class="scroll"><table>
    <thead><tr><th>Register</th><th class="m">Ark</th><th class="m">Images</th><th class="m">Falco</th><th>What was in it</th></tr></thead>
    <tbody>
      {READ.map((r) => (
        <tr>
          <td><strong>{r.kind} {r.year}</strong></td>
          <td class="m">{r.ark}</td>
          <td class="m">{r.imgs}</td>
          <td class="m">{r.falco === 0 ? <span class="chip dis">none</span> : r.falco}</td>
          <td>{r.found}<br/><span class="small">{r.note}</span></td>
        </tr>
      ))}
    </tbody>
  </table></div>

  <h2>Searched and not found</h2>
  <p class="dek">Set down so nobody repeats them.</p>
  {NOT_FOUND.map(([what, where, result]) => (
    <section class="card" style="margin:1rem 0">
      <h3 style="margin-bottom:.3rem">{what}</h3>
      <p class="small mono" style="margin:.1rem 0 .5rem">{where}</p>
      <p style="margin:.2rem 0">{result}</p>
    </section>
  ))}

  <h2>Still to read</h2>
  <p class="dek">The Arienzo death registers for <strong>1826–1828</strong> and
  <strong>1837–1843</strong>, the birth registers before 1816 and after 1818, and the
  <em>processetti</em>, 258 volumes across four towns, of which none have been read.</p>
  <p class="small"><strong>1816, 1817 and 1818 have now been read in full, and they closed the
  question they were opened for:</strong> the Raffaele Falco born in April 1816 was buried on 28
  October 1817, so the Raffaele born in May 1818 is generation four. Across the three years the
  Falco dead are: none in 1816, Maria Falco and the infant Raffaele in 1817, none in 1818.</p>
  <p class="small">One qualification on the table above, stated rather than hidden: for the 1816
  death register, images 3–39 were read in full <em>for Falco</em> — and the Falco answer is firm —
  but the act-by-act roster of the other families in that stretch was not written down at the time.
  Recovering it needs a second pass, and that pass is queued.</p>
  <p class="small">Everything above is in <a href={u("/open-questions")}>Open questions</a> with what
  it would take to answer it.</p>
</Base>
