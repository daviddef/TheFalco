---
import Base from "../layouts/Base.astro";
import Searched from "@daviddef/archive-kit/components/Searched.astro";
import P from "../components/P.astro";
import { u } from "../lib/url.js";
import { md } from "../lib/md.js";
import raw from "../data/searched.json";
import nf from "../data/namefold.json";   /* variant -> canonical, for search only */
const REPO = "https://github.com/daviddef/TheFalco";

/* What has been read, page by page, and what was in it — including the years
   that held nothing. A null is a result: it is what stops the next person
   reading the same volume again.

   THE OUTCOME WORDS ARE THIS ARCHIVE'S OWN, and they are six because six
   different things happen to a search here:
     found         something new came back
     no Falco      the volume was read end to end and the family is not in it
     not there     the one record sought is not in a source that holds others
     nothing       the source holds nothing for this family at all
     blocked       the film is obstructed, or the volume was never digitised
     not searched  deliberately declined, with the reasoning set down
   «no Falco», «not there» and «nothing» are the nulls, and the count of them
   is the number this page exists to publish. */
/* The kit takes `what` and `got` as HTML the archive has already rendered and
   based with its own helpers, so they go through md() here rather than being
   escaped into literal asterisks and backticks. */
const rows = raw.map((r) => ({ ...r, what: md(r.what, u), got: md(r.got, u) }));
const NIL = ["no Falco", "not there", "nothing"];
const nils = raw.filter((r) => NIL.includes(r.outcome)).length;
const full = raw.filter((r) => (r.tags || []).includes("read in full")).length;
const imgs = raw.reduce((a, r) => a + (+(String(r.src).match(/(\d+) images/) || [])[1] || 0), 0);

/* COVERAGE BY SERIES, DERIVED — never typed.
   This page has twice carried a sentence that was true when written and false
   a week later: «five annual death registers have been read in full» when
   fifty had been, and «what remains is 1809-1811, 1814-1815» after those years
   were read. The table below was right both times; the paragraph summarising
   it was not, because the table is generated and the paragraph was typed.
   So the paragraph is generated now too. A row counts for a year only if it
   carries BOTH the series tag and «read in full» — a partly-read volume, like
   the 1845 births where only images 110-139 were swept, must not be claimed. */
const SPAN = { from: 1809, to: 1865 };
const yearsOf = (w) => {
  const out = new Set(); const t = String(w || "");
  for (const m of t.matchAll(/\b(18\d\d)\s*[\u2013\u2014-]\s*(18\d\d)\b/g))
    for (let y = +m[1]; y <= +m[2]; y++) out.add(y);
  for (const m of t.matchAll(/\b(18\d\d)\b/g)) out.add(+m[1]);
  return out;
};
const readIn = (tag) => {
  const out = new Set();
  for (const r of raw) {
    const tg = r.tags || [];
    if (tg.includes(tag) && tg.includes("read in full"))
      for (const y of yearsOf(r.when)) if (y >= SPAN.from && y <= SPAN.to) out.add(y);
  }
  return out;
};
const runs = (set) => {
  const ys = [...set].sort((a, b) => a - b); const o = [];
  for (const y of ys) { if (o.length && y === o[o.length - 1][1] + 1) o[o.length - 1][1] = y; else o.push([y, y]); }
  return o.map(([a, b]) => (a === b ? `${a}` : `${a}\u2013${b}`)).join(", ");
};
const gap = (set) => { const o = new Set(); for (let y = SPAN.from; y <= SPAN.to; y++) if (!set.has(y)) o.add(y); return o; };
const DTH = readIn("Deaths"), BTH = readIn("Births"), MRG = readIn("Marriages");
const WORD = ["no","One","Two","Three","Four","Five","Six","Seven","Eight","Nine","Ten"];
const num = (n) => WORD[n] || String(n);
---

<Base title="What Has Been Read"
      eyebrow="Coverage, including the years that held nothing"
      dek={`${rows.length} searches on the record, ${nils} of which came back empty. ${full} annual registers read page by page — ${imgs} images, some two thousand acts. This page exists so that a null is not lost: knowing a volume has been read and holds nothing is the difference between «we have not looked» and «it is not there».`}>

  <div class="card" style="border-left:3px solid var(--accent)">
    <p><strong>Why record the negatives.</strong> A family archive that only publishes its finds
    invites the next person to repeat every search that failed. <strong>{nils} of the {rows.length}
    searches below returned nothing</strong>, and several of those nulls overturned or unsettled
    something this archive had been relying on. Every register read act by act is logged in the
    <a href={REPO + "/tree/main/notes"}>reading logs</a>, with each father's age, trade and street.</p>
    <p class="small" style="margin-top:.6rem"><strong>The outcome words are this archive's own, and
    they are not interchangeable.</strong> <em>No Falco</em> means a volume was read end to end and
    the family is not in it. <em>Not there</em> means the one record sought is missing from a source
    that holds others. <em>Nothing</em> means the source holds nothing for this family at all.
    <em>Blocked</em> means the film is obstructed or the volume was never digitised — which is not a
    negative, it is an obstacle. <em>Not searched</em> means the decision to skip it was taken
    deliberately and the reasoning is in the row.</p>
  </div>

  <h2>Six more years, read a different way — and then read again</h2>
  <div class="card" style="margin-bottom:1.2rem">
    <p><strong>The Arienzo death registers for 1809–1814</strong> — six years nobody had touched —
    were read on 13 September 2026 <strong>through their indexes rather than act by act</strong>. Each
    year is one to five images instead of about fifty, and each index lists every death of the year
    <strong>with both parents named</strong>.</p>
    <p style="margin-top:.6rem">They produced <strong>six Falco</strong>, including a daughter of
    generation two this archive did not have — <P n="Giovanna Falco" bold={true} />, died 15 December
    1812 — and the confirmation, from the 1851 index, that
    <P n="Gioacchino Falco" bold={true} /> was a son of <P n="Matteo Falco" bold={true} /> and
    <P n="Francesca Crisci" bold={true} />.</p>
    <p class="small" style="margin-top:.6rem"><strong>That was September, and it has been
    superseded.</strong> The indexes were a first pass over years nobody had opened; between 21 and
    23 September 2026 <strong>every act of 1809–1815 was read from the image, on both halves of every
    page</strong>. The index reading stands as what it was — a fast way in — and the qualification it
    carried, that 1809, 1810 and 1812 were only partly swept, <strong>no longer limits anything</strong>.
    <a href={u("/method/")}>Why this replaced the act-by-act sweep →</a></p>
    <p class="small"><strong>It also nearly cost four Falco.</strong> The act-by-act pass that
    followed was first run with a band reading one half of each page, on a recipe that said these
    volumes carry one act to an opening. They carry <strong>two acts to an image</strong>. The sweep
    read exactly half of them, consistently, so nothing looked missing — and both acts already found
    happened to sit on right-hand pages. <a href={u("/corrections/")}>The correction →</a></p>
  </div>

  <h2>The register of what has been read</h2>
  <p class="dek">Filter by what the search returned, or by what it was about. Set down so nobody
  repeats them.</p>
  <Searched fold={nf.fold} rows={rows} u={u} nil={NIL} unit="searches" />

  <h2>Still to read</h2>
  <p class="dek"><strong>The Arienzo DEATH registers are finished.</strong> {DTH.size} consecutive
  volumes — <strong>{runs(DTH)}</strong>, every year Antenati holds — have been read act by act.
  The <strong>BIRTH registers</strong> are read for <strong>{runs(BTH)}</strong>; what remains there
  is <strong>{runs(gap(BTH))}</strong>. The <strong>MARRIAGE</strong> side has its indexes read for
  1809–1849 — the series stops there — and its registers for <strong>{runs(MRG)}</strong>. Beyond
  Arienzo: the <strong>Forchia birth register for 1897</strong> that nobody has indexed, and the
  <em>processetti</em> — <strong>378 volumes across six towns, of which three bundles have now
  been read</strong>. <a href={u("/processetti/")}>The six towns, volume by volume →</a></p>
  <p class="small"><strong>That paragraph was typed, it went stale twice, and it is now
  generated.</strong> It first said the remaining births were «before 1816 and after 1818», which had
  stopped being true by the time 1819 was read; it was rewritten on 22 September and was wrong again
  within a day, because it named 1809–1811 and 1814–1815 as unread on the morning those volumes were
  finished. <em>The table above was right every time; the sentence summarising it was not, because
  the table is generated and the sentence was typed.</em> <strong>Every year and count in the
  paragraph above is now read out of the same rows the table is built from</strong>, and a year is
  counted only if its row says «read in full» — so the 1845 births, where images 110–139 were swept
  and the rest were not, are correctly absent from it.</p>
  <p class="small">One qualification on the table above, stated rather than hidden: for the 1816
  death register, images 3–39 were read in full <em>for Falco</em> — and the Falco answer is firm —
  but the act-by-act roster of the other families in that stretch was not written down at the time.
  Recovering it needs a second pass, and that pass is queued.</p>
  <p class="small">Everything above is in <a href={u("/open-questions/")}>Open questions</a> with what
  it would take to answer it.</p>
</Base>
