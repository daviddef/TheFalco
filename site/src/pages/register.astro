---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import register from "../data/register.json";
import { people as reconstructed } from "../lib/people.js";

const bySlug = new Map(reconstructed.map((p) => [p.name.toLowerCase(), p.slug]));
const groups = new Map();
for (const r of register) {
  if (!groups.has(r.surname)) groups.set(r.surname, []);
  groups.get(r.surname).push(r);
}
const surnames = [...groups.keys()].sort((a, b) => groups.get(b).length - groups.get(a).length || a.localeCompare(b));
const linked = register.filter((r) => r.link).length;
const distinct = new Set(register.map((r) => r.name.toLowerCase())).size;
const KIND = {
  index: "surname index", record: "record", cited: "cited by this archive",
  burial: "burial", file: "archive file", household: "reconstructed", swept: "read in the register", tree: "family tree",
};
// Every row either links to its source or says here why it cannot.
const WHYNOLINK = {
  tree: "no link — the family tree is private",
  burial: "no link — the cemetery portal answers only to a POST, so a row has no address of its own",
  cited: "no link — held as a family scan, not published",
  household: "no link — joined from records listed elsewhere on this page",
  swept: "no link — the volume is not yet on Antenati",
};
const unlinked = register.length - linked;
---
<Base title="The register"
      eyebrow="Every named individual this archive has found"
      dek={`${register.length} entries for ${distinct} distinct names, ${linked} of them with a link to the source that names them; the other ${unlinked} say in the Source column why no link exists. This is the raw catch — not a family tree, and most of it is not this family.`}>

  <div class="card" style="border-left:3px solid var(--accent)">
    <h3 style="margin-bottom:.4rem">Read this before you read the list</h3>
    <p>Most of these entries come from <strong>surname indexes</strong> — every Falco, Zampiello and
    Annecchino the Antenati name index holds for the Valle Caudina towns, and every hit from the
    FamilySearch harvests. <strong>A shared surname is not a relationship.</strong> The Falco of
    Paolisi and Moiano in particular are largely a different population: their in-laws barely overlap
    with the Crisci, Morgillo, Martone and Rivetti that this family married into.</p>
    <p style="margin-top:.6rem">Entries marked <em>family tree</em> come from the family's own
    MyHeritage tree — <strong>290 deceased people on the Falco side</strong>, walked out from
    Giuseppina Falco. They are what the family believes, not what a record proves: treat each as a
    claim until it appears somewhere else on this page with a source beside it. The
    <strong>137 living</strong> people on that side are excluded entirely, as everywhere else in this
    build, and the tree is private, so these entries carry no link.</p>
    <p style="margin-top:.6rem">Entries marked <em>read in the register</em> are people this archive
    met while reading the Arienzo registers act by act — neighbours, declarants, the families who
    buried each other's children on strada Camellara. They are here because they were found, not
    because they are kin. <strong>Nineteen annual death registers are now logged act by act —
    1816 to 1826, and 1829 to 1836</strong> — and from 1820 on, when the Arienzo form grew fuller,
    every person in every act is here: the deceased, both parents, the spouse, and both declarants
    with age, trade and street. The birth registers of <strong>1816–1818</strong> contribute every
    father read. The one gap, stated rather than hidden, is the first thirty-nine images of the
    <strong>1816 death register</strong>: they were read in full for Falco — and held none — but the
    roster of the other families in them was not written down at the time, and recovering it needs a
    second pass. Everything is also in the
    <a href="https://github.com/daviddef/TheFalco/tree/main/notes">reading logs</a>.</p>
    <p style="margin-top:.6rem">The <span class="chip doc">reconstructed</span> entries are the ones
    this archive has actually joined into households from the words of a record. Those names link to
    a <a href={u("/people")}>person page</a>. Everything else links out to the source and is offered
    as a lead, not a conclusion.</p>
  </div>

  <div class="card" style="margin:1.2rem 0">
    <label class="lab" for="q">Filter by name, place, year or source</label>
    <input id="q" type="search" placeholder="Camellara · 1832 · Michelangelo · Arpaia …"
           style="width:100%;margin-top:.5rem;padding:.6rem .7rem;font-family:var(--sans);
                  font-size:15px;border:1px solid var(--rule-strong);border-radius:4px;
                  background:var(--ground);color:var(--ink)" />
    <p class="small" id="count" style="margin-top:.5rem">{register.length} entries shown</p>
  </div>

  {surnames.map((sn) => (
    <section class="sur" data-sur={sn} style="margin:1.6rem 0">
      <h2 style="margin-bottom:.3rem">{sn} <span class="small mono">{groups.get(sn).length}</span></h2>
      <div class="scroll">
        <table>
          <thead><tr><th>Name</th><th>What the source says</th><th>Source</th></tr></thead>
          <tbody>
            {groups.get(sn).map((r) => (
              <tr class="row" data-hay={(r.name + " " + r.detail + " " + r.source).toLowerCase()}>
                <td>
                  {bySlug.has(r.name.toLowerCase())
                    ? <a href={u("/people/" + bySlug.get(r.name.toLowerCase()))}>{r.name}</a>
                    : r.name}
                  {r.kind === "household" ? <><br/><span class="chip doc">reconstructed</span></> : null}
                </td>
                <td>{r.detail}</td>
                <td class="small">
                  {r.link ? <a href={r.link} rel="noopener">{KIND[r.kind] || r.kind} ↗</a>
                          : <span title={WHYNOLINK[r.kind] || "no public link"}>{(KIND[r.kind] || r.kind) + " · " + (WHYNOLINK[r.kind] || "no public link")}</span>}
                  <br/><span style="color:var(--ink-3)">{r.source}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}

  <script is:inline>
    (function () {
      var q = document.getElementById("q"), count = document.getElementById("count");
      var rows = [].slice.call(document.querySelectorAll("tr.row"));
      var secs = [].slice.call(document.querySelectorAll("section.sur"));
      var t;
      function run() {
        var v = q.value.trim().toLowerCase();
        var n = 0;
        rows.forEach(function (r) {
          var hit = !v || r.getAttribute("data-hay").indexOf(v) !== -1;
          r.hidden = !hit; if (hit) n++;
        });
        secs.forEach(function (s) {
          s.hidden = !s.querySelector("tr.row:not([hidden])");
        });
        count.textContent = n + (n === 1 ? " entry shown" : " entries shown");
      }
      q.addEventListener("input", function () { clearTimeout(t); t = setTimeout(run, 120); });
    })();
  </script>
</Base>
